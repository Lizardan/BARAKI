/* BARAKI Launcher — graphite dark-fantasy, compact window chrome */

* {
    -unity-font: url("../Fonts/NotoSans.ttf");
}

.ln-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgb(8, 9, 8);
    overflow: hidden;
}

.ln-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(8, 9, 8);
}

.ln-ambient {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 42%;
    opacity: 0.55;
}

.ln-ambient--left {
    left: -4%;
    background-color: rgba(185, 154, 98, 0.07);
}

.ln-ambient--right {
    right: -6%;
    background-color: rgba(133, 137, 128, 0.05);
}

.ln-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 9, 8, 0.18);
}

.ln-shell {
    position: relative;
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(16, 18, 17);
    overflow: hidden;
}

.ln-corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border-color: rgb(185, 154, 98);
}

.ln-corner--tl {
    left: 0;
    top: 0;
    border-left-width: 2px;
    border-top-width: 2px;
}

.ln-corner--br {
    right: 0;
    bottom: 0;
    border-right-width: 2px;
    border-bottom-width: 2px;
}

/* Header */

.ln-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 74px;
    flex-shrink: 0;
    padding-left: 28px;
    padding-right: 52px;
    background-color: rgb(16, 18, 17);
    border-bottom-width: 1px;
    border-bottom-color: rgb(52, 56, 50);
}

.ln-brand {
    flex-direction: row;
    align-items: center;
    gap: 16px;
    flex-shrink: 1;
    min-width: 0;
}

.ln-brand__title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(208, 178, 118);
    letter-spacing: 4px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

.ln-brand__tagline {
    display: none;
}

.ln-brand__version {
    font-size: 11px;
    color: rgb(98, 102, 95);
    letter-spacing: 1px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

/* Body: news + chat */

.ln-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.ln-main {
    flex-grow: 1;
    min-width: 0;
    padding: 22px;
}

.ln-news {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    background-color: rgb(21, 23, 22);
    border-radius: 0;
}

.ln-news-header {
    height: 45px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 18px;
    padding-right: 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(52, 56, 50);
}

.ln-side {
    width: 34%;
    min-width: 260px;
    max-width: 380px;
    flex-shrink: 0;
    padding-top: 22px;
    padding-right: 22px;
    padding-bottom: 22px;
    padding-left: 0;
}

.ln-section-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(185, 154, 98);
    letter-spacing: 2px;
}

.ln-section-subtitle {
    display: none;
}

/* Buttons */

.ln-btn {
    height: 46px;
    min-width: 150px;
    margin: 0;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(75, 77, 69);
    background-color: rgb(28, 30, 27);
    color: rgb(208, 178, 118);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    transition-duration: 0.18s;
    transition-property: background-color, border-color, color;
    outline-width: 0;
}

.ln-btn:hover {
    background-color: rgb(36, 39, 35);
    border-color: rgb(185, 154, 98);
    color: rgb(208, 178, 118);
}

.ln-btn:active {
    background-color: rgb(16, 18, 17);
}

.ln-btn:disabled {
    opacity: 0.4;
}

.ln-btn--play {
    height: 46px;
    min-width: 190px;
    width: auto;
    margin: 0;
    flex-shrink: 0;
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(208, 178, 118);
    background-color: rgb(64, 54, 35);
    border-color: rgb(185, 154, 98);
}

.ln-btn--play:hover {
    background-color: rgb(80, 66, 40);
    border-color: rgb(208, 178, 118);
    color: rgb(222, 219, 210);
}

.ln-btn--play:active {
    background-color: rgb(52, 43, 28);
}

.ln-btn--return {
    min-width: 190px;
    background-color: rgb(28, 30, 27);
    letter-spacing: 1px;
    font-size: 11px;
}

.ln-btn--hidden {
    display: none;
}

.ln-btn--outline {
    width: auto;
    min-width: 120px;
    height: 32px;
    margin-top: 6px;
    background-color: rgba(8, 9, 8, 0.55);
    border-color: rgb(75, 77, 69);
    color: rgb(208, 178, 118);
    font-size: 11px;
}

.ln-btn--outline:hover {
    background-color: rgb(28, 30, 27);
    border-color: rgb(185, 154, 98);
}

.ln-btn--send {
    width: 110px;
    min-width: 110px;
    height: 42px;
    margin-left: 8px;
    background-color: rgb(28, 30, 27);
    border-color: rgb(75, 77, 69);
    color: rgb(208, 178, 118);
    font-size: 11px;
}

.ln-btn--send:hover {
    border-color: rgb(185, 154, 98);
    background-color: rgb(36, 39, 35);
}

/* Window chrome (borderless launcher) */

.ln-window-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    border-radius: 0;
}

.ln-window-chrome {
    position: absolute;
    top: 0;
    right: 0;
    width: 26px;
    height: 26px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-start;
}

.ln-btn--close {
    width: 26px;
    min-width: 26px;
    height: 26px;
    padding-left: 0;
    padding-right: 0;
    /* ✕ lives in Symbols 2 — not in Noto Sans */
    -unity-font: url("../Fonts/NotoSansSymbols2-Regular.ttf");
    font-size: 12px;
    letter-spacing: 0;
    -unity-font-style: normal;
    color: rgb(222, 219, 210);
    background-color: rgb(28, 30, 27);
    border-width: 1px;
    border-color: rgb(185, 154, 98);
}

.ln-btn--close:hover {
    background-color: rgb(118, 46, 46);
    border-color: rgb(160, 78, 78);
    color: rgb(222, 219, 210);
}

.ln-btn--close:active {
    background-color: rgb(86, 34, 34);
}

/* Footer / progress */

.ln-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    flex-shrink: 0;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgb(16, 18, 17);
    border-top-width: 1px;
    border-top-color: rgb(52, 56, 50);
}

.ln-progress {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    gap: 4px;
    margin: 0;
    padding: 0;
    padding-right: 28px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ln-progress__kicker {
    height: 14px;
    margin: 0;
    padding: 0;
    padding-left: 22px;
    font-size: 10px;
    color: rgb(98, 102, 95);
    letter-spacing: 2px;
    -unity-text-align: middle-left;
}

.ln-progress__head {
    flex-direction: row;
    align-items: center;
    height: 22px;
    gap: 0;
}

.ln-status-dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 14px;
    border-radius: 4px;
    background-color: rgb(127, 167, 119);
}

.ln-progress__status {
    height: 22px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 18px;
    padding: 0;
    font-size: 13px;
    color: rgb(222, 219, 210);
    letter-spacing: 0;
    flex-grow: 0;
    flex-shrink: 0;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.ln-progress__percent {
    height: 22px;
    min-width: 40px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    color: rgb(133, 137, 128);
    letter-spacing: 1px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.ln-progress__details {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
    min-width: 96px;
    width: auto;
    height: 22px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 18px;
    padding: 0;
}

.ln-progress__details--hidden {
    display: none;
}

.ln-progress__track {
    position: relative;
    width: auto;
    height: 4px;
    background-color: rgb(28, 30, 27);
    border-width: 0;
    border-radius: 0;
    overflow: hidden;
}

.ln-progress__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: rgb(185, 154, 98);
    transition-duration: 0.15s;
    transition-property: width;
}

.ln-progress__shine {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 32px;
    left: -32px;
    background-color: rgba(208, 178, 118, 0.28);
}

.ln-progress__error {
    font-size: 11px;
    color: rgb(156, 73, 61);
    white-space: normal;
    letter-spacing: 0;
    margin: 0;
    padding: 0;
}

.ln-progress__error--hidden {
    display: none;
}

.ln-footer-actions {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    margin-left: 25px;
}

/* Hero (featured news strip) */

.ln-hero {
    height: 148px;
    min-height: 120px;
    max-height: 168px;
    flex-shrink: 0;
    margin: 14px 14px 0;
    border-radius: 0;
    overflow: hidden;
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    position: relative;
    background-color: rgb(28, 30, 27);
}

.ln-hero__image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(28, 30, 27);
}

.ln-hero__shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 9, 8, 0.35);
}

.ln-hero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 0;
    padding: 16px 18px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 4px;
}

.ln-hero__kicker {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(133, 137, 128);
}

.ln-hero__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(208, 178, 118);
    letter-spacing: 1px;
}

.ln-hero__body {
    max-width: 640px;
    font-size: 12px;
    color: rgb(133, 137, 128);
    white-space: normal;
    margin-bottom: 2px;
}

/* News list */

.ln-news-scroll {
    flex-grow: 1;
    min-height: 80px;
}

.ln-news-scroll > .unity-scroller,
.ln-news-scroll > .unity-scroller--vertical {
    display: none;
    width: 0;
    min-width: 0;
    margin: 0;
}

.ln-chat-scroll {
    flex-grow: 1;
    min-height: 80px;
    padding-right: 0;
}

.ln-chat-scroll .unity-scroller,
.ln-chat-scroll .unity-scroller--vertical {
    display: none;
    width: 0;
    min-width: 0;
    margin: 0;
}

.ln-news-list {
    flex-direction: column;
    gap: 10px;
    padding: 14px;
}

.ln-news-card {
    width: auto;
    min-width: 0;
    max-width: none;
    flex-grow: 0;
    flex-direction: column;
    border-radius: 0;
    overflow: hidden;
    background-color: rgb(28, 30, 27);
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    padding: 15px 17px;
    transition-duration: 0.2s;
    transition-property: border-color, background-color;
}

.ln-news-card:hover {
    border-color: rgb(75, 77, 69);
    background-color: rgb(36, 39, 35);
}

.ln-news-card__image {
    display: none;
    height: 0;
}

.ln-news-card__image--a,
.ln-news-card__image--b,
.ln-news-card__image--c {
    background-color: rgb(28, 30, 27);
}

.ln-news-card__body {
    padding: 0;
    flex-direction: column;
    gap: 5px;
}

.ln-news-card__date {
    margin-top: 0;
    margin-bottom: 1px;
    font-size: 10px;
    color: rgb(98, 102, 95);
    letter-spacing: 1px;
}

.ln-news-card__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(208, 178, 118);
    white-space: normal;
}

.ln-news-card__desc {
    font-size: 12px;
    color: rgb(133, 137, 128);
    white-space: normal;
}

/* Chat */

.ln-chat {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    background-color: rgb(16, 18, 17);
    border-radius: 0;
}

.ln-chat-header {
    height: 45px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 15px;
    padding-right: 15px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(52, 56, 50);
    margin-bottom: 0;
}

.ln-chat-tabs {
    flex-shrink: 0;
    flex-direction: row;
    gap: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(52, 56, 50);
}

.ln-chat-tab {
    flex-grow: 1;
    height: 36px;
    margin: 0;
    padding: 0 8px;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(16, 18, 17);
    color: rgb(133, 137, 128);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.ln-chat-tab:hover {
    color: rgb(222, 219, 210);
}

.ln-chat-tab--active {
    color: rgb(185, 154, 98);
    background-color: rgb(22, 24, 22);
    border-bottom-width: 2px;
    border-bottom-color: rgb(185, 154, 98);
}

.ln-chat-scroll--hidden {
    display: none;
}

.ln-chat-messages {
    flex-direction: column;
    gap: 14px;
    padding: 14px;
}

.ln-chat-message {
    flex-direction: column;
    gap: 3px;
    padding: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ln-chat-message__avatar {
    display: none;
    width: 0;
    height: 0;
}

.ln-chat-message__avatar-text {
    font-size: 18px;
    color: rgb(222, 219, 210);
}

.ln-chat-message__content {
    flex-grow: 1;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}

.ln-chat-message__meta {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: 12px;
}

.ln-chat-message__nick {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(185, 154, 98);
}

.ln-chat-message__time {
    font-size: 15px;
    color: rgb(98, 102, 95);
}

.ln-chat-message__text {
    font-size: 18px;
    color: rgb(133, 137, 128);
    white-space: normal;
}

.ln-chat-composer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 10px;
    border-top-width: 0;
}

.ln-chat-input {
    flex-grow: 1;
    height: 42px;
    margin: 0;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    background-color: rgb(8, 9, 8);
    color: rgb(133, 137, 128);
    padding-left: 2px;
    padding-right: 2px;
}

.ln-chat-input > .unity-base-field__input,
.ln-chat-input > .unity-base-text-field__input,
.ln-chat-input .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(222, 219, 210);
    --unity-cursor-color: rgb(185, 154, 98);
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 0;
}
