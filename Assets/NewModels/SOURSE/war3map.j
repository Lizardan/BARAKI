function d9G takes string x9G returns integer
local string K9G=x9G
local integer M9G
local gamecache H9G
local string A9G
local integer X9G
if K9G==StringCase(K9G,true) then
set K9G=K9G+"U"
endif
set M9G=Nmq(Sv,"c2i",K9G)
if M9G<0 or M9G>=dv or SubString(Xv,M9G,M9G+1)!=x9G and u4k(Sv,"c2i",K9G) then
loop
exitwhen M9G>=dv
if x9G==SubString(Xv,M9G,M9G+1) then
if Av then
call BJDebugMsg("MMD: Guard Raised! (c2i poisoned)")
endif
set Pp=wp
set H9G=Sv
set A9G=K9G
set X9G=M9G
call StoreInteger(H9G,"c2i",A9G,X9G)
exitwhen true
endif
set M9G=M9G+1
endloop
endif
set H9G=null
return M9G
endfunction
function j_P takes string Z_P,integer l_P returns integer
local integer e_P=Ebw(Z_P)
local integer B_P=e_P+l_P
local integer i_P=0
local integer T_P=e_P-1
loop
exitwhen i_P>T_P
set B_P=B_P*41+d9G(SubString(Z_P,i_P,i_P+1))
set i_P=i_P+1
endloop
return B_P
endfunction
function Q_P takes integer u_P,string O_P returns integer
local integer N_P=UXG()
local integer a_P=N_P
local integer D_P=u_P
local string f_P=O_P
local integer b_P=a_P
set O6[b_P]=.0
set N6[b_P]=""
set a6[b_P]=0
set D6[b_P]=""
set f6[b_P]=0
set O6[a_P]=cmR()+7.+GetRandomReal(0.,3.)
set N6[a_P]=f_P
set a6[a_P]=j_P(f_P,D_P)
set D6[a_P]=UIP(D_P)
return N_P
endfunction
function hIP takes integer kIP returns nothing
local integer qIP=kIP
local gamecache wIP=Sv
local string PIP=Rp+D6[qIP]
local string ZIP=N6[qIP]
local integer lIP=a6[qIP]
local gamecache eIP
local string BIP
local string iIP
local integer TIP
local gamecache jIP
local string LIP
local string WIP
local gamecache nIP
local string rIP
local string tIP
call StoreInteger(wIP,PIP,ZIP,lIP)
set eIP=Sv
set BIP=kp+D6[qIP]
set iIP=D6[qIP]
set TIP=a6[qIP]
call StoreInteger(eIP,BIP,iIP,TIP)
set jIP=Sv
set LIP=Rp+D6[qIP]
set WIP=N6[qIP]
call SyncStoredInteger(jIP,LIP,WIP)
set nIP=Sv
set rIP=kp+D6[qIP]
set tIP=D6[qIP]
call SyncStoredInteger(nIP,rIP,tIP)
set wIP=null
set eIP=null
set jIP=null
set nIP=null
endfunction
function kYR takes nothing returns boolean
local integer c_R=0
local integer U_R=0
local integer array YYR
local boolean array GYR
local integer RYR
loop
exitwhen U_R>3
if GetPlayerController(aE[U_R])==MAP_CONTROL_USER and GetPlayerSlotState(aE[U_R])==PLAYER_SLOT_STATE_PLAYING then
if c_R<Pp then
set YYR[c_R]=U_R
set GYR[U_R]=true
else
set RYR=GetRandomInt(0,c_R)
if RYR<Pp then
set GYR[YYR[RYR]]=false
set YYR[RYR]=U_R
set GYR[U_R]=true
endif
endif
set c_R=c_R+1
endif
set U_R=U_R+1
endloop
return GYR[N1G(DE)]
endfunction
function JXw takes string AXw returns nothing
local integer XXw
local string dXw
local integer yXw
if not yv then
set dXw="MMD Emit Error: Library not initialized yet."
set yXw=0
loop
call DisplayTimedTextToPlayer(Player(yXw),0.,0.,60.,dXw)
set yXw=yXw+1
exitwhen yXw==bj_MAX_PLAYERS
endloop
return
endif
set XXw=Q_P(Zp,AXw)
if ep==0 then
set ep=XXw
else
set f6[Bp]=XXw
endif
set Bp=XXw
set Zp=Zp+1
if kYR() then
call hIP(XXw)
endif
endfunction
