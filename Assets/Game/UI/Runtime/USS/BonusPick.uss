.bonus-pick {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(15, 15, 16, 0.45);
}

.bonus-pick__center {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 24px;
}

.bonus-pick__panel {
    /* Same footprint as match-bottom-dock__panel so ui-btn--square keeps barracks proportions. */
    width: 350px;
    min-width: 350px;
    max-width: 350px;
    padding: 6px;
}

.bonus-pick__inner {
    flex-grow: 1;
    justify-content: flex-start;
}

.bonus-pick__title {
    font-size: 13px;
    letter-spacing: 4px;
}

.bonus-pick__timer {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(125, 117, 104);
    letter-spacing: 2px;
    min-width: 48px;
    -unity-text-align: middle-right;
}

.bonus-pick__status {
    margin-bottom: 10px;
}

.bonus-pick__grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
    padding: 4px;
}

.bonus-pick__slot {
    /* size from ui-btn--square (same as match-command-grid__slot) */
    overflow: hidden;
    position: relative;
}

.bonus-pick__slot--picked {
    opacity: 0.6;
    background-color: rgb(86, 103, 122);
    border-color: rgb(125, 117, 104);
}

.bonus-pick__slot--locked {
    opacity: 0.45;
}

.bonus-pick__portrait {
    position: absolute;
    left: 6px;
    top: 6px;
    right: 6px;
    bottom: 6px;
    picking-mode: ignore;
    background-color: rgba(0, 0, 0, 0);
    background-size: cover;
    -unity-background-scale-mode: scale-and-crop;
    background-position-x: 50%;
    background-position-y: 0%;
    overflow: hidden;
}

.bonus-pick-tooltip {
    position: absolute;
    max-width: 240px;
    padding: 8px 10px;
    background-color: rgba(9, 9, 10, 0.96);
    border-width: 2px;
    border-color: rgba(125, 117, 104, 0.55);
    z-index: 1000;
}

.bonus-pick-tooltip--hidden {
    display: none;
}

.bonus-pick-tooltip__label {
    font-size: 12px;
    color: rgb(239, 228, 207);
    white-space: normal;
    -unity-text-align: middle-left;
}

.bonus-pick--hidden {
    display: none;
}
