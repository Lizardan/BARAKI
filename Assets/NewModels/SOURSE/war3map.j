set bj_wantDestroyGroup=false
set bj_groupAddGroupDest=RXG
call ForGroup(GXG,function GroupAddGroupEnum)
if kXG then
call DestroyGroup(GXG)
endif
set cAG=0.
set UAG=0.
set SAG=FirstOfGroup(yAG)
loop
exitwhen SAG==null
call GroupRemoveUnit(yAG,SAG)
set cAG=cAG+GetUnitX(SAG)
set UAG=UAG+GetUnitY(SAG)
set SAG=FirstOfGroup(yAG)
endloop
set SAG=uqk(YXG,GetUnitX(SAG),GetUnitY(SAG),false)
endif
endif
set PIY=SAG
set SAG=null
set YXG=null
set GXG=null
set RXG=null
return PIY
endfunction
