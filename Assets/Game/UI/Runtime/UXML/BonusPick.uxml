<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Game/UI/Runtime/USS/BonusPick.uss" />
    <ui:Style src="project://database/Assets/Game/UI/Runtime/USS/BarakiTheme.uss" />
    <ui:VisualElement name="BonusPickOverlay" class="bonus-pick" picking-mode="Ignore">
        <ui:VisualElement class="bonus-pick__center" picking-mode="Ignore">
            <ui:VisualElement class="ui-chrome bonus-pick__panel">
                <ui:VisualElement class="bonus-pick__inner">
                    <ui:VisualElement class="ui-panel__header">
                        <ui:Label text="ВЫБОР БОНУСА" class="ui-panel__header-text bonus-pick__title" />
                        <ui:Label name="BonusPickTimer" text="60" class="bonus-pick__timer" />
                    </ui:VisualElement>
                    <ui:Label text="Выберите бонус — матч уже идёт" class="ui-panel__note bonus-pick__status" />
                    <ui:VisualElement name="BonusPickGrid" class="bonus-pick__grid" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BonusPickTooltip" class="bonus-pick-tooltip bonus-pick-tooltip--hidden" picking-mode="Ignore">
            <ui:Label name="BonusPickTooltipLabel" text="" class="bonus-pick-tooltip__label" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
