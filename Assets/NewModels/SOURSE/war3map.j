function Xrw takes trigger Hrw,boolexpr Arw returns triggercondition
return TriggerAddCondition(Hrw,Arw)
endfunction
function A4Z takes nothing returns boolean
local trigger H4Z
set Wr=CreateTrigger()
call TriggerRegisterEnterRectSimple(Wr,bj_mapInitialPlayableArea)
call Xrw(Wr,Condition(NaY))
set H4Z=Wr
call DisableTrigger(H4Z)
set H4Z=null
return true
endfunction
function N1G takes player O1G returns integer
return GetPlayerId(O1G)
endfunction
function KFk takes unit xFk returns integer
return GetUnitTypeId(xFk)
endfunction
function dkG takes unit AkG,integer XkG returns boolean
return IssueImmediateOrderById(AkG,XkG)
endfunction
function foZ takes integer NoZ returns nothing
local integer aoZ
local integer DoZ
if Qk[NoZ]>=1 then
call dkG(r[NoZ],wY[NoZ])
elseif GetRandomInt(1,$64)<=15 then
call dkG(r[NoZ],wY[NoZ])
endif
if KFk(r[NoZ])==E[NoZ] or KFk(r[NoZ])==s[NoZ]then
if GetRandomInt(1,$64)<=40 then
set aoZ=GetRandomInt(1,4)
if aoZ==1 then
call dkG(r[NoZ],kY[NoZ])
elseif aoZ==2 then
call dkG(r[NoZ],qY[NoZ])
elseif aoZ==3 then
call dkG(r[NoZ],PY[NoZ])
elseif aoZ==4 then
call dkG(r[NoZ],ZY[NoZ])
endif
endif
elseif GetRandomInt(1,$64)<=30 then
set DoZ=GetRandomInt(1,4)
if DoZ==1 then
call dkG(r[NoZ],kY[NoZ])
elseif DoZ==2 then
call dkG(r[NoZ],qY[NoZ])
elseif DoZ==3 then
call dkG(r[NoZ],PY[NoZ])
elseif DoZ==4 then
call dkG(r[NoZ],ZY[NoZ])
endif
endif
endfunction
function A7Z takes nothing returns nothing
local integer H7Z=N1G(jR)
call foZ(H7Z)
endfunction
function A9R takes nothing returns nothing
call IssuePointOrder(GetEnteringUnit(),"attack",xY[35],KY[35])
endfunction
