local real YnR=GetUnitY(xWR)
local real GnR=MWR+UDZ(xWR)
local real RnR=GetUnitX(KWR)
local real knR=GetUnitY(KWR)
local real qnR=MWR+UDZ(KWR)
local real wnR=dWR/(JWR/.04)
local boolean PnR=IsUnitVisible(xWR,q)
local boolean ZnR=IsUnitVisible(KWR,q)
local lightning lnR
call FlushChildHashtable(kR,cWR)
set lnR=AddLightningEx(sWR,false,UWR,YnR,GnR,RnR,knR,qnR)
call SaveReal(kR,cWR,5,dWR)
if (not PnR)or(not ZnR) then
set dWR=0.
endif
call SetLightningColor(lnR,HWR,AWR,XWR,dWR)
call TimerStart(SWR,.015,true,mPY)
call SaveLightningHandle(kR,cWR,1,lnR)
call SaveReal(kR,cWR,2,wnR)
call SaveReal(kR,cWR,3,yWR)
call SaveReal(kR,cWR,4,yWR+JWR)
call SaveUnitHandle(kR,cWR,5,xWR)
call SaveUnitHandle(kR,cWR,6,KWR)
