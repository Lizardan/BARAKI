.match-hud {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.match-hud-chrome {
    background-color: rgb(16, 18, 17);
    background-image: none;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(52, 56, 50);
    border-radius: 0;
}

.match-hud__top-bar {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 12px;
    height: 52px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 8px;
    padding-right: 8px;
}

.match-hud__camera-pad {
    position: absolute;
    left: 16px;
    top: 72px;
    flex-direction: row;
    align-items: center;
    padding: 4px;
}

.match-hud__camera-pad-cross {
    width: 120px;
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
}

.match-hud__camera-pad-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 2px;
    margin-bottom: 2px;
}

.match-hud__camera-pad-spacer {
    width: 36px;
    height: 36px;
}

.match-hud__camera-pad-btn {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    margin: 0;
    padding: 0;
    font-size: 18px;
    letter-spacing: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(75, 77, 69);
    background-color: rgb(28, 30, 27);
    color: rgb(208, 178, 118);
    transition-duration: 0.18s;
    transition-property: background-color, border-color, color;
}

.match-hud__camera-pad-btn:hover {
    background-color: rgb(36, 39, 35);
    border-color: rgb(185, 154, 98);
    scale: 1;
}

.match-hud__camera-pad-btn:active {
    background-color: rgb(16, 18, 17);
    scale: 1;
}

.match-hud__camera-pad-btn--selected {
    background-color: rgb(64, 54, 35);
    border-color: rgb(185, 154, 98);
    color: rgb(208, 178, 118);
}

.match-hud__camera-pad-hint {
    margin-left: 10px;
    max-width: 148px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(133, 137, 128);
    white-space: normal;
    -unity-text-align: middle-left;
    letter-spacing: 0.5px;
    line-height: 16px;
}

/* Полоска: время матча слева, таймер арены по центру (absolute),
   золото прижато вправо через auto-margin. */
.match-hud__time {
    min-width: 72px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(222, 219, 210);
    -unity-text-align: middle-left;
}

.match-hud__time-caption {
    margin-left: 8px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(133, 137, 128);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.match-hud__gold-row {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.match-hud__gold-caption {
    margin-right: 8px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(133, 137, 128);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.match-hud__gold {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 214, 96);
    -unity-text-align: middle-left;
}

.match-hud__command-feedback {
    margin-left: 8px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 170, 120);
    letter-spacing: 0.5px;
}

.match-hud__command-feedback--hidden {
    display: none;
}

.match-hud__migration {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 9, 8, 0.82);
    justify-content: center;
    align-items: center;
}

.match-hud__migration--hidden {
    display: none;
}

.match-hud__migration-label {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(222, 219, 210);
    letter-spacing: 1px;
}

.ui-dialog.match-hud__disconnect-panel {
    align-items: center;
    padding: 8px;
    min-width: 360px;
    background-color: rgb(21, 23, 22);
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    border-radius: 0;
}

.ui-dialog__title.match-hud__disconnect-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(208, 178, 118);
    letter-spacing: 3px;
    margin-bottom: 8px;
}

.match-hud__disconnect-body {
    font-size: 18px;
    color: rgb(222, 219, 210);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    white-space: normal;
}

.match-hud__disconnect-actions {
    flex-direction: row;
    justify-content: center;
}

.ui-btn.match-hud__disconnect-kick {
    height: 69px;
    width: 100%;
    margin: 0 0 8px 0;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(75, 77, 69);
    background-color: rgb(28, 30, 27);
    color: rgb(208, 178, 118);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    transition-duration: 0.18s;
    transition-property: background-color, border-color, color;
}

.ui-btn.match-hud__disconnect-kick:hover {
    background-color: rgb(36, 39, 35);
    border-color: rgb(185, 154, 98);
    scale: 1;
}

.ui-btn.match-hud__disconnect-kick:active {
    background-color: rgb(16, 18, 17);
    scale: 1;
}

.match-hud__disconnect-kick--hidden {
    display: none;
}

.match-hud__start-countdown {
    margin-left: 20px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(133, 137, 128);
    letter-spacing: 0.5px;
}

.match-hud__start-countdown--hidden {
    display: none;
}

.match-hud__barracks-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.match-hud__barracks-timer {
    position: absolute;
    width: 56px;
    height: 32px;
    margin-left: -28px;
    margin-top: -16px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 0 0 6px rgba(0, 0, 0, 1), 0 2px 10px rgba(0, 0, 0, 0.95);
}

.match-hud__barracks-timer--inactive {
    color: rgba(220, 220, 220, 0.55);
}

.match-hud__results {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 9, 8, 0.82);
}

.match-hud__results--hidden {
    display: none;
}

.ui-dialog.match-hud__results-panel {
    width: 480px;
    max-width: 88%;
    align-items: center;
    justify-content: center;
    padding: 8px;
    background-color: rgb(21, 23, 22);
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    border-radius: 0;
}

.match-hud__results-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 214, 96);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.match-hud__results-actions {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 8px;
}

.ui-btn.match-hud__results-btn {
    height: 69px;
    width: 100%;
    margin: 0 8px 0 0;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(75, 77, 69);
    background-color: rgb(28, 30, 27);
    color: rgb(208, 178, 118);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    transition-duration: 0.18s;
    transition-property: background-color, border-color, color;
}

#ResultsLobbyButton {
    margin-right: 0;
}

.ui-btn.match-hud__results-btn:hover {
    background-color: rgb(36, 39, 35);
    border-color: rgb(185, 154, 98);
    scale: 1;
}

.ui-btn.match-hud__results-btn:active {
    background-color: rgb(16, 18, 17);
    scale: 1;
}

.match-hud__debug {
    position: absolute;
    right: 16px;
    top: 72px;
    width: 160px;
    flex-direction: column;
    padding: 8px;
    background-color: rgb(16, 18, 17);
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    border-radius: 0;
}

.match-hud__debug--hidden {
    display: none;
}

.match-hud__debug-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(133, 137, 128);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.ui-btn.match-hud__debug-btn {
    height: 28px;
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 12px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(75, 77, 69);
    background-color: rgb(28, 30, 27);
    color: rgb(208, 178, 118);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.18s;
    transition-property: background-color, border-color, color;
}

#DebugWaypointsButton {
    margin-bottom: 0;
}

.ui-btn.match-hud__debug-btn:hover {
    background-color: rgb(36, 39, 35);
    border-color: rgb(185, 154, 98);
    scale: 1;
}

.ui-btn.match-hud__debug-btn:active {
    background-color: rgb(16, 18, 17);
    scale: 1;
}

.match-command-tooltip {
    position: absolute;
    max-width: 220px;
    padding: 8px 10px;
    background-color: rgb(21, 23, 22);
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    z-index: 1000;
}

.match-command-tooltip--hidden {
    display: none;
}

.match-command-tooltip__label {
    font-size: 12px;
    color: rgb(222, 219, 210);
    white-space: normal;
    -unity-text-align: middle-left;
}

.match-hud__passive-ring {
    position: absolute;
    width: 36px;
    height: 36px;
    margin-left: -18px;
    margin-top: -18px;
}

.match-hud__titan-ring {
    position: absolute;
    width: 72px;
    height: 10px;
    margin-left: -36px;
    margin-top: -5px;
}

.match-extra-ability {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.match-extra-ability--hidden {
    display: none;
}

.match-extra-ability__dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 9, 8, 0.82);
}

.ui-dialog.match-extra-ability__panel {
    width: 420px;
    max-width: 90%;
    align-items: stretch;
    padding: 8px;
    background-color: rgb(21, 23, 22);
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    border-radius: 0;
}

.ui-dialog__title.match-extra-ability__title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(208, 178, 118);
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.ui-panel__note.match-extra-ability__note {
    font-size: 12px;
    color: rgb(133, 137, 128);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.match-extra-ability__list {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
    padding: 0;
    margin-bottom: 8px;
}

.match-extra-ability__btn {
    width: 31%;
    height: 72px;
    margin: 1%;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 11px;
    border-width: 1px;
    border-color: rgb(75, 77, 69);
    background-color: rgb(28, 30, 27);
}

.match-extra-ability__btn--locked {
    opacity: 0.35;
}

.match-extra-ability__btn--picked {
    border-color: rgb(210, 180, 90);
}

.ui-btn.match-extra-ability__close {
    height: 69px;
    width: 100%;
    margin: 0;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(75, 77, 69);
    background-color: rgb(28, 30, 27);
    color: rgb(208, 178, 118);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    transition-duration: 0.18s;
    transition-property: background-color, border-color, color;
}

.ui-btn.match-extra-ability__close:hover {
    background-color: rgb(36, 39, 35);
    border-color: rgb(185, 154, 98);
    scale: 1;
}

.ui-btn.match-extra-ability__close:active {
    background-color: rgb(16, 18, 17);
    scale: 1;
}

.match-targeting-tooltip {
    position: absolute;
    left: 0;
    top: 0;
    max-width: 220px;
    padding: 6px 10px;
    background-color: rgba(9, 9, 10, 0.94);
    border-width: 2px;
    border-color: rgba(200, 70, 60, 0.75);
    z-index: 1100;
}

.match-targeting-tooltip--hidden {
    display: none;
}

.match-targeting-tooltip__label {
    font-size: 12px;
    color: rgb(255, 214, 200);
    white-space: normal;
    -unity-text-align: middle-left;
}

.match-chat {
    position: absolute;
    left: 24px;
    bottom: 220px;
    width: 460px;
    max-height: 320px;
    flex-direction: column;
    justify-content: flex-end;
}

.match-chat__messages {
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    min-height: 0;
    flex-grow: 1;
}

.match-chat__line {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 224, 140);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 0 0 6px rgba(0, 0, 0, 1), 0 2px 8px rgba(0, 0, 0, 0.95);
    white-space: normal;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 0;
}

.match-chat__composer {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 10px;
    background-color: rgb(16, 18, 17);
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    picking-mode: position;
}

.match-chat__composer--hidden {
    display: none;
}

.match-chat__input {
    flex-grow: 1;
    min-width: 0;
    height: 42px;
    margin: 0;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    background-color: rgb(8, 9, 8);
    color: rgb(255, 236, 196);
    font-size: 18px;
    padding-left: 2px;
    padding-right: 2px;
}

.match-chat__input > .unity-base-field__input,
.match-chat__input > .unity-base-text-field__input,
.match-chat__input .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(255, 236, 196);
    font-size: 18px;
}

.match-chat__send {
    height: 42px;
    min-width: 120px;
    margin: 0;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(185, 154, 98);
    background-color: rgba(185, 154, 98, 0.35);
    color: rgb(222, 219, 210);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.match-chat__send:hover {
    background-color: rgba(185, 154, 98, 0.55);
}
