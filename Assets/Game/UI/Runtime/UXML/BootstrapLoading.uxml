<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../USS/BarakiTheme.uss" />
    <ui:Style src="../USS/BootstrapLoading.uss" />
    <ui:VisualElement name="BootstrapScreen" class="ui-screen bl" picking-mode="Position">
        <ui:VisualElement name="MenuBackdrop" class="ui-bg bl__bg" picking-mode="Ignore" />
        <ui:VisualElement class="bl__ambient bl__ambient--fire" picking-mode="Ignore" />
        <ui:VisualElement class="bl__ambient bl__ambient--ice" picking-mode="Ignore" />
        <ui:VisualElement class="ui-bg-shade bl__shade" picking-mode="Ignore" />
        <ui:VisualElement class="ui-vignette bl__vignette" picking-mode="Ignore" />

        <ui:VisualElement name="Shell" class="bl__shell" picking-mode="Ignore">
            <ui:VisualElement name="ContentRow" class="bl__content" picking-mode="Ignore">
                <ui:VisualElement class="bl__main-stack" picking-mode="Ignore">
                    <ui:VisualElement name="ChatPanel" class="bl__hero ui-panel ui-panel--lg" picking-mode="Ignore">
                        <ui:VisualElement class="ui-panel__inner bl__hero-inner" picking-mode="Ignore">
                            <ui:VisualElement class="bl__hero-copy" picking-mode="Ignore">
                                <ui:Label text="ОБЩИЙ КАНАЛ" class="bl__hero-kicker" picking-mode="Ignore" />
                                <ui:Label
                                    text="Подготовка группы к матчу"
                                    class="bl__hero-title"
                                    picking-mode="Ignore" />
                                <ui:Label
                                    text="Чат становится главным блоком экрана, а новости и состояние клиента остаются рядом и читаются сразу."
                                    class="bl__hero-body"
                                    picking-mode="Ignore" />

                                <ui:VisualElement class="bl__chat-room" picking-mode="Ignore">
                                    <ui:VisualElement class="bl__chat-message" picking-mode="Ignore">
                                        <ui:Label text="Aegis" class="bl__chat-author" picking-mode="Ignore" />
                                        <ui:Label text="Кто идёт в следующий ранкед?" class="bl__chat-text" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="bl__chat-message bl__chat-message--self" picking-mode="Ignore">
                                        <ui:Label text="Ты" class="bl__chat-author" picking-mode="Ignore" />
                                        <ui:Label text="Сначала обновлюсь и залечу через минуту." class="bl__chat-text" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="bl__chat-message" picking-mode="Ignore">
                                        <ui:Label text="Mira" class="bl__chat-author" picking-mode="Ignore" />
                                        <ui:Label text="Я уже в лобби, ждём ещё одного." class="bl__chat-text" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="bl__chat-message bl__chat-message--self" picking-mode="Ignore">
                                        <ui:Label text="Ghost" class="bl__chat-author" picking-mode="Ignore" />
                                        <ui:Label text="Забираю саппорта, кидайте инвайт." class="bl__chat-text" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="bl__hero-metrics" picking-mode="Ignore">
                                    <ui:Label text="14 ИГРОКОВ ONLINE" class="bl__hero-chip" picking-mode="Ignore" />
                                    <ui:Label text="3 АКТИВНЫХ ЛОББИ" class="bl__hero-chip" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="LauncherBar" class="bl__launcher ui-panel ui-panel--lg" picking-mode="Position">
                        <ui:VisualElement class="ui-panel__inner bl__launcher-inner" picking-mode="Position">
                            <ui:VisualElement name="StatusDock" class="bl__status-dock" picking-mode="Ignore">
                                <ui:VisualElement name="TopChrome" class="bl__status-head" picking-mode="Ignore">
                                    <ui:Label name="SideStatusTitle" text="ЗАПУСК И ОБНОВЛЕНИЕ" class="bl__status-tag" picking-mode="Ignore" />
                                    <ui:Label name="VersionLabel" text="v0.0.0" class="bl__version-text" picking-mode="Ignore" />
                                </ui:VisualElement>

                                <ui:VisualElement name="VersionProgress" class="bl__progress-shell ui-overlay--hidden" picking-mode="Ignore">
                                    <ui:VisualElement name="VersionProgressTrack" class="bl__progress-track">
                                        <ui:VisualElement name="VersionProgressFill" class="bl__progress-fill" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <ui:VisualElement class="bl__status-text-row" picking-mode="Ignore">
                                    <ui:Label name="VersionProgressLabel" text="" class="bl__status-inline ui-overlay--hidden" picking-mode="Ignore" />
                                    <ui:Label name="SideStatusLabel" text="" class="bl__status-text" picking-mode="Ignore" />
                                </ui:VisualElement>

                                <ui:VisualElement class="bl__status-foot" picking-mode="Ignore">
                                    <ui:VisualElement name="UpdateMeta" class="bl__update-meta bl__slot--inactive" picking-mode="Ignore">
                                        <ui:VisualElement name="UpdateRangeLabel" class="bl__range" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:Label name="UpdateStatusLabel" text="" class="bl__update-error bl__slot--inactive" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement name="ActionDock" class="bl__action-dock" picking-mode="Position">
                                <ui:VisualElement class="bl__action-dock-inner" picking-mode="Position">
                                    <ui:VisualElement name="CtaSlot" class="bl__cta-slot" picking-mode="Position">
                                        <ui:VisualElement name="IdleCtaPanel" class="bl__idle-cta" picking-mode="Ignore">
                                            <ui:Label name="IdleCtaLabel" text="ПОДГОТОВКА…" class="bl__idle-cta-label" picking-mode="Ignore" />
                                        </ui:VisualElement>

                                        <ui:VisualElement name="LoadingPanel" class="bl__action-panel ui-overlay--hidden" picking-mode="Position">
                                            <ui:Button name="EnterGameButton" text="ИГРАТЬ" class="ui-btn ui-btn--primary bl__cta" />
                                        </ui:VisualElement>

                                        <ui:VisualElement name="UpdatePanel" class="bl__action-panel ui-overlay--hidden" picking-mode="Position">
                                            <ui:VisualElement name="UpdateButtonHost" class="bl__cta-host" picking-mode="Position">
                                                <ui:Button name="UpdateButton" text="ОБНОВИТЬ" class="ui-btn ui-btn--primary bl__cta bl__cta--update" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>

                                    <ui:Button name="QuitButton" text="ВЫХОД" class="ui-btn ui-btn--muted bl__cta bl__quit" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="bl__side" picking-mode="Ignore">
                    <ui:VisualElement name="SideRail" class="bl__rail ui-panel ui-panel--lg" picking-mode="Ignore">
                        <ui:VisualElement class="ui-panel__inner bl__rail-inner" picking-mode="Ignore">
                            <ui:VisualElement name="NewsFeed" class="bl__rail-head" picking-mode="Ignore">
                                <ui:Label text="ЛЕНТА ОБНОВЛЕНИЙ" class="bl__rail-kicker" picking-mode="Ignore" />
                                <ui:VisualElement name="NewsFeatured" class="bl__rail-featured" picking-mode="Ignore">
                                    <ui:Label name="NewsFeaturedTag" text="ПАТЧ" class="bl__news-card__tag" picking-mode="Ignore" />
                                    <ui:Label name="NewsFeaturedTitle" text="" class="bl__rail-featured-title" picking-mode="Ignore" />
                                    <ui:Label name="NewsFeaturedBody" text="" class="bl__rail-featured-body" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:ScrollView name="NewsScroll" class="bl__rail-scroll" picking-mode="Position">
                                <ui:VisualElement name="NewsListContainer" class="bl__news-list" picking-mode="Ignore" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label name="LoadingTitleLabel" text="ПОДГОТОВКА" class="bl__sr" picking-mode="Ignore" />
            <ui:Label name="StatusLabel" text="" class="bl__sr" picking-mode="Ignore" />
            <ui:Label name="UpdateTitleLabel" text="ДОСТУПНО ОБНОВЛЕНИЕ" class="bl__sr" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
