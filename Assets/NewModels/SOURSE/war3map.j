function Xtk takes real utk,real Otk,real Ntk,string atk,real Dtk,integer ftk,integer btk,integer Qtk,integer vtk returns texttag
local texttag ptk=CreateTextTag()
local texttag Vtk=ptk
local real mtk=Jpk(mbZ(utk,Otk,Ntk),xwY,20.)
local real Ftk=qPY
local real gtk=wPY
local real otk=mtk
local real Ctk=Ftk
local real Itk=gtk
local texttag Etk
local texttag stk
local texttag xtk
local texttag Ktk
local string Mtk
local texttag Htk
local texttag Atk
call SetTextTagPos(Vtk,otk,Ctk,Itk)
set Etk=ptk
set Ktk=Etk
set Mtk=atk
call SetTextTagText(Ktk,Mtk,Dtk*.0023)
set stk=Etk
set Htk=stk
call SetTextTagColor(Htk,ftk,btk,Qtk,vtk)
set xtk=stk
set Atk=xtk
call SetTextTagVisibility(Atk,true)
set mIY=xtk
set ptk=null
set Vtk=null
set Etk=null
set stk=null
set xtk=null
set Ktk=null
set Htk=null
set Atk=null
return mIY
endfunction
