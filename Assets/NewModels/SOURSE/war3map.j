function eLk takes unit sjk,integer xjk returns nothing
local integer Kjk
local integer Mjk
local integer Hjk
local integer Ajk
local unit Xjk
local real djk
local real yjk
local unit Jjk
local unit Sjk
local real cjk
local real Ujk
local unit YLk
local unit GLk
local real RLk
local real kLk
local unit qLk
local unit wLk
local real PLk
local real ZLk
local unit lLk
if sjk==Yk[xjk] and(not wG) then
set Xjk=Yk[xjk]
set djk=kk[0]
set yjk=qk[0]
call SetUnitPosition(Xjk,djk,yjk)
set Jjk=Yk[xjk]
call ShowUnit(Jjk,true)
set Kjk=mtZ()
set hYY[Kjk]=xjk
call Hpk(.2,Kjk)
