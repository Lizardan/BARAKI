function oBZ takes integer FBZ returns nothing
local integer gBZ=0
if Player(FBZ)==iR then
if vXP(Dj,12) and QR then
call QxR(Dj,12)
endif
set gBZ=L3Z(Dj)
call QxR(Dj,gBZ)
call QxR(vj,gBZ)
endif
if Player(FBZ)==TR then
if vXP(fj,12) and QR then
call QxR(fj,12)
endif
set gBZ=L3Z(fj)
call QxR(fj,gBZ)
call QxR(pj,gBZ)
endif
if Player(FBZ)==jR then
if vXP(bj,12) and QR then
call QxR(bj,12)
endif
set gBZ=L3Z(bj)
call QxR(bj,gBZ)
call QxR(Vj,gBZ)
endif
if Player(FBZ)==LR then
if vXP(Qj,12) and QR then
call QxR(Qj,12)
endif
set gBZ=L3Z(Qj)
call QxR(Qj,gBZ)
call QxR(mj,gBZ)
endif
if gBZ==1 then
call dkG(oY[FBZ],rY[FBZ])
elseif gBZ==2 then
call dkG(oY[FBZ],tY[FBZ])
elseif gBZ==3 then
call dkG(oY[FBZ],hY[FBZ])
elseif gBZ==4 then
call dkG(oY[FBZ],uY[FBZ])
elseif gBZ==5 then
call dkG(oY[FBZ],OY[FBZ])
elseif gBZ==6 then
call dkG(oY[FBZ],NY[FBZ])
elseif gBZ==7 then
call dkG(oY[FBZ],aY[FBZ])
elseif gBZ==8 then
call dkG(oY[FBZ],DY[FBZ])
elseif gBZ==9 then
call dkG(oY[FBZ],fY[FBZ])
elseif gBZ==10 then
call dkG(oY[FBZ],bY[FBZ])
elseif gBZ==11 then
call dkG(oY[FBZ],QY[FBZ])
elseif gBZ==12 then
call dkG(oY[FBZ],vY[FBZ])
endif
endfunction
function LAZ takes integer jAZ returns string
if jAZ==0 then
return "drawer"
elseif jAZ==1 then
return "loser"
elseif jAZ==2 then
return "winner"
elseif jAZ==3 then
return "leaver"
else
return "practicing"
endif
endfunction
function h_P takes string n_P,integer r_P,integer t_P returns string
return SubString(n_P,r_P,t_P)
endfunction
function P1w takes string G1w,string R1w,integer k1w returns integer
local integer q1w=k1w
local integer w1w=Ebw(G1w)-Ebw(R1w)
loop
exitwhen q1w>w1w
if h_P(G1w,q1w,q1w+Ebw(R1w))==R1w then
return q1w
endif
set q1w=q1w+1
endloop
return -1
endfunction
function YQZ takes string ybZ,string JbZ returns integer
local integer SbZ=Ebw(JbZ)
local integer cbZ=0
local integer UbZ=Ebw(ybZ)-SbZ
loop
exitwhen cbZ>UbZ
if h_P(ybZ,cbZ,cbZ+SbZ)==JbZ then
return cbZ
endif
set cbZ=cbZ+1
endloop
return -1
endfunction
function lAk takes string kAk,string qAk,string wAk returns string
local string PAk=kAk
local integer ZAk
if Ebw(qAk)>0 then
set ZAk=YQZ(kAk,qAk)
loop
exitwhen ZAk==-1
set PAk=h_P(PAk,0,ZAk)+wAk+h_P(PAk,ZAk+Ebw(qAk),Ebw(PAk))
set ZAk=P1w(PAk,qAk,ZAk+Ebw(wAk))
endloop
endif
return PAk
endfunction
