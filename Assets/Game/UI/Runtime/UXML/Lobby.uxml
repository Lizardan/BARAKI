<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../USS/Lobby.uss" />
    <ui:VisualElement name="LobbyScreen" class="lobby">
        <ui:VisualElement class="lobby__bg" />
        <ui:VisualElement class="lobby__shade" />

        <ui:VisualElement class="lobby__stage">
            <ui:VisualElement class="lobby__header">
                <ui:Label name="LobbyTitleLabel" text="ЛОББИ" class="ui-title ui-title--sm" />
                <ui:Label name="LobbySubtitleLabel" text="Ожидание игроков" class="ui-tagline" />
                <ui:Label name="RoomCodeLabel" text="КОД: ----" class="ui-meta lobby__code" />
            </ui:VisualElement>

            <ui:VisualElement class="lobby__panel-wrap">
                <ui:VisualElement class="lobby__panel">
                    <ui:VisualElement class="lobby__panel-header">
                        <ui:Label text="СЛОТЫ" class="lobby__panel-title" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lobby__panel-body">
                        <ui:VisualElement name="SlotList" class="lobby__slots" />
                        <ui:Button name="ReadyButton" text="ГОТОВ" class="lobby__btn lobby__btn--primary" />
                        <ui:Button name="FillLocalButton" text="ЗАПОЛНИТЬ СЛОТЫ (ЛОКАЛЬНО)" class="lobby__btn" />
                        <ui:Button name="StartButton" text="СТАРТ" class="lobby__btn lobby__btn--primary" />
                        <ui:Button name="InviteFriendsButton" text="ПРИГЛАСИТЬ ДРУЗЕЙ" class="lobby__btn" />
                        <ui:Button name="BackButton" text="НАЗАД" class="lobby__btn lobby__btn--muted" />
                        <ui:VisualElement class="lobby__hints">
                            <ui:Label text="Старт — когда все готовы" class="lobby__hints-text" />
                            <ui:Label text="Esc — назад" class="lobby__hints-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="FriendsInviteOverlay" class="lobby__overlay lobby__overlay--hidden">
            <ui:VisualElement class="lobby__overlay-dim" />
            <ui:VisualElement class="lobby__dialog lobby__friends-invite">
                <ui:VisualElement class="lobby__dialog-header">
                    <ui:Label text="ПРИГЛАСИТЬ ДРУЗЕЙ" class="lobby__dialog-title" />
                    <ui:Button name="FriendsInviteCloseButton" text="×" class="lobby__dialog-close" />
                </ui:VisualElement>
                <ui:VisualElement class="lobby__dialog-body">
                    <ui:Label text="Онлайн-друзья получат приглашение в текущую комнату." class="lobby__friends-hint" />
                    <ui:ScrollView name="LobbyFriendsScroll" class="lobby__friends-scroll" mode="Vertical">
                        <ui:VisualElement name="LobbyFriendsListContainer" class="lobby__friends-list-container" />
                    </ui:ScrollView>
                    <ui:Label name="LobbyFriendsErrorLabel" text="" class="lobby__friends-error" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
