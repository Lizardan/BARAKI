{
  "name": "baraki-task-launcher",
  "displayName": "BARAKI Task Launcher",
  "description": "Задачи BARAKI в сайдбаре: клик по issue запускает opencode; выполненные уходят в закрытые",
  "version": "0.0.51",
  "publisher": "lizardan",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "baraki-tasks",
          "title": "BARAKI Задачи",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "baraki-tasks": [
        {
          "id": "barakiTasks.taskList",
          "name": "Задачи"
        },
        {
          "id": "barakiTasks.quickPrompt",
          "name": "Новая задача",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "barakiTaskLauncher.launchIssue",
        "title": "BARAKI: Запустить issue в opencode",
        "icon": "$(play-circle)"
      },
      {
        "command": "barakiTaskLauncher.resumeLastTask",
        "title": "Открыть последнюю сессию opencode",
        "icon": "$(history)"
      },
      {
        "command": "barakiTaskLauncher.refresh",
        "title": "Обновить список задач",
        "icon": "$(refresh)"
      },
      {
        "command": "barakiTaskLauncher.startTask",
        "title": "Запустить выбранную задачу в opencode",
        "icon": "$(play)"
      },
      {
        "command": "barakiTaskLauncher.resumeTask",
        "title": "Открыть сессию opencode этой задачи (без нового промта)",
        "icon": "$(terminal)"
      },
      {
        "command": "barakiTaskLauncher.doneTask",
        "title": "Апрув: закрыть задачу и сессию",
        "icon": "$(check)"
      },
      {
        "command": "barakiTaskLauncher.closeTask",
        "title": "Закрыть выбранный issue",
        "icon": "$(close)"
      },
      {
        "command": "barakiTaskLauncher.previewIssue",
        "title": "Предпросмотр задачи (markdown как на GitHub)",
        "icon": "$(book)"
      },
      {
        "command": "barakiTaskLauncher.refreshSummary",
        "title": "Анализ проекта и выбор следующей задачи",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "barakiTaskLauncher.launchIssue",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "barakiTaskLauncher.startTask",
          "when": "view == barakiTasks.taskList && viewItem =~ /^issue:(ready):/",
          "group": "inline@1"
        },
        {
          "command": "barakiTaskLauncher.resumeTask",
          "when": "view == barakiTasks.taskList && viewItem =~ /^issue:(running|review):/",
          "group": "inline@2"
        },
        {
          "command": "barakiTaskLauncher.doneTask",
          "when": "view == barakiTasks.taskList && viewItem =~ /^issue:review:/",
          "group": "inline@3"
        },
        {
          "command": "barakiTaskLauncher.closeTask",
          "when": "view == barakiTasks.taskList && viewItem =~ /^issue:(ready|running):/",
          "group": "inline@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "barakiTaskLauncher.launchIssue",
        "key": "ctrl+alt+shift+t"
      }
    ],
    "configuration": {
      "title": "BARAKI Task Launcher",
      "properties": {
        "barakiTaskLauncher.repo": {
          "type": "string",
          "default": "Lizardan/BARAKI",
          "description": "GitHub репозиторий для списка issues."
        },
        "barakiTaskLauncher.label": {
          "type": "string",
          "default": "todo-task",
          "description": "Метка задач, попадающих в панель (пусто = все открытые)."
        },
        "barakiTaskLauncher.autoRefreshSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "description": "Период автообновления списка в секундах (0 = только вручную)."
        }
      }
    }
  }
}
