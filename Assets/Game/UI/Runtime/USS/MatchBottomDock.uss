.match-bottom-dock {
    position: absolute;
    left: 100px;
    right: 100px;
    bottom: 12px;
    height: 350px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-start;
}

.match-dock-panel {
    padding: 0;
    flex-direction: column;
    flex-shrink: 0;
}

.match-dock-panel__inner {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    height: 100%;
    border-width: 0;
}

.match-bottom-dock__panel {
    width: 350px;
    min-width: 350px;
    max-width: 350px;
    height: 350px;
    flex-shrink: 0;
}

.match-bottom-dock__panel.match-dock-panel {
    width: 350px;
    min-width: 350px;
    max-width: 350px;
    height: 350px;
}

.match-bottom-dock__panel--right {
    margin-left: auto;
}

.match-bottom-dock__context {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    width: auto;
    max-width: none;
    margin-left: 8px;
    margin-right: 8px;
    height: 300px;
}

.match-bottom-dock__context.match-dock-panel {
    width: auto;
    max-width: none;
    height: 300px;
    flex-grow: 1;
    flex-shrink: 1;
}

.match-dock-panel__inner--active {
    background-color: rgba(0, 0, 0, 0);
}

.match-minimap__panel-body {
    flex-grow: 1;
    flex-direction: column;
    padding: 0;
    height: 100%;
    width: 100%;
}

.match-bottom-dock__context .match-panel__content-root {
    height: 100%;
    width: 100%;
}

.match-bottom-dock__minimap-canvas {
    position: relative;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    overflow: hidden;
}

.match-minimap__geometry-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.match-minimap__fog-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.match-minimap__blip {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 0;
    transform-origin: center;
    background-color: rgb(200, 200, 200);
}

.match-minimap__blip--building {
    width: 7px;
    height: 7px;
    border-radius: 0;
}

.match-minimap__blip--base {
    width: 9px;
    height: 9px;
    border-radius: 0;
}

.match-minimap__blip--selected {
    border-width: 2px;
    border-color: rgb(239, 228, 207);
}

.match-minimap__blip--ruins {
    background-color: rgb(120, 60, 60);
}

.match-context-strip__mode {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 0;
}

.match-context-strip__mode--hidden {
    display: none;
}

.match-context-strip__unit-row {
    flex-direction: row;
    align-items: flex-start;
    height: 100%;
    width: 100%;
    padding: 8px;
}

.match-context-strip__portrait {
    width: 120px;
    height: 120px;
    margin-right: 8px;
    background-color: rgb(28, 30, 27);
}

.match-context-strip__center-col {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    overflow: hidden;
}

.match-context-strip__title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(222, 219, 210);
    margin-bottom: 2px;
}

.match-context-strip__owner {
    font-size: 13px;
    color: rgb(133, 137, 128);
    margin-bottom: 8px;
}

.match-context-strip__owner--hidden {
    display: none;
    margin-bottom: 0;
}

.match-context-strip__stat-grid {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.match-context-strip__stat-line {
    font-size: 14px;
    color: rgb(222, 219, 210);
    margin-bottom: 3px;
}

.match-context-strip__stat-line--hidden {
    display: none;
}

.match-context-strip__research-block {
    margin-top: auto;
    flex-shrink: 0;
}

.match-context-strip__research-block--hidden {
    display: none;
}

.match-context-strip__research-queue {
    flex-direction: row;
    justify-content: flex-start;
    margin-bottom: 8px;
    gap: 8px;
}

.match-context-strip__research-queue-slot {
    width: 48px;
    height: 36px;
    margin-right: 0;
    padding: 2px;
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    background-color: rgb(8, 9, 8);
    font-size: 11px;
    color: rgb(222, 219, 210);
    -unity-text-align: middle-center;
    white-space: normal;
}

.match-context-strip__research-queue-slot--active {
    border-color: rgb(185, 154, 98);
    background-color: rgb(28, 30, 27);
}

.match-context-strip__research-label {
    font-size: 14px;
    color: rgb(133, 137, 128);
    margin-bottom: 8px;
}

.match-context-strip__research-bar {
    height: 18px;
    width: 100%;
}

.match-command-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
    padding: 8px 8px 8px 8px;
}

.match-command-grid--hidden,
.match-unit-info--hidden {
    display: none;
}

.match-command-grid__slot {
    /* size from ui-btn--square */
    overflow: hidden;
    position: relative;
}

.ui-btn--square.match-command-grid__slot {
    overflow: hidden;
    background-color: rgb(28, 30, 27);
    border-width: 1px;
    border-color: rgb(75, 77, 69);
    color: rgb(208, 178, 118);
    padding: 0;
    margin: 0;
}

.ui-btn--square.match-command-grid__slot:hover {
    background-color: rgb(36, 39, 35);
    border-color: rgb(185, 154, 98);
}

.ui-btn--square.match-command-grid__slot:active {
    background-color: rgb(16, 18, 17);
}

.ui-btn--square.match-command-grid__slot--locked {
    opacity: 0.72;
    color: rgba(222, 219, 210, 0.85);
    border-color: rgba(52, 56, 50, 0.85);
}

.ui-btn--square.match-command-grid__slot--locked:disabled {
    opacity: 0.72;
}

.match-command-portrait {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    picking-mode: ignore;
    background-color: rgba(0, 0, 0, 0);
    background-size: cover;
    -unity-background-scale-mode: scale-and-crop;
    background-position-x: 50%;
    background-position-y: 0%;
}

.match-command-regen-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    picking-mode: ignore;
}

.match-command-charge {
    position: absolute;
    right: 4px;
    bottom: 1px;
    picking-mode: ignore;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(222, 219, 210);
    -unity-text-align: lower-right;
    text-shadow: 1px 1px 2px rgb(0, 0, 0);
}

.match-unit-info {
    flex-grow: 1;
    flex-direction: column;
    padding: 8px;
    overflow: hidden;
}

.match-inspector__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(222, 219, 210);
}

.match-inspector__owner {
    font-size: 13px;
    color: rgb(133, 137, 128);
    margin-top: 3px;
}

.match-inspector__hp {
    font-size: 14px;
    color: rgb(222, 219, 210);
    margin-bottom: 4px;
    margin-top: 8px;
}

.match-inspector__meta {
    font-size: 13px;
    color: rgb(133, 137, 128);
}

.match-inspector__badge {
    font-size: 12px;
    color: rgb(220, 120, 100);
    margin-top: 4px;
}

.match-inspector__readonly {
    font-size: 12px;
    color: rgb(133, 137, 128);
    margin-top: 8px;
    -unity-font-style: italic;
}

.match-inspector__panel-body {
    flex-grow: 1;
    flex-direction: column;
    padding: 0;
}

.match-panel__content-root {
    position: relative;
    flex-grow: 1;
}

.match-panel__empty-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(9, 9, 10, 0.25);
}

.match-panel__empty-overlay--hidden {
    display: none;
}

.match-inspector--empty .match-command-grid,
.match-inspector--empty .match-unit-info {
    display: none;
}

/* Minimap panel: no padding, map flush to chrome frame */
#MinimapPanel {
    padding: 0;
}

#MinimapCanvas {
    width: 100%;
    height: 100%;
}

/* Research queue last slot: no margin-right since parent uses gap */
#ResearchQueueSlot2 {
    margin-right: 0;
}
