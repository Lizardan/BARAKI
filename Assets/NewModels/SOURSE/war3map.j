function IfP takes real afP,real DfP returns integer
local integer ffP=PZw()
local integer bfP=ffP
local integer QfP=bfP
local framehandle vfP
local framehandle pfP
local framehandle VfP
local framehandle mfP
local framehandle FfP
local framehandle gfP
local framehandle ofP
local framehandle CfP
set mRY[QfP]=0.
set FRY[QfP]=0.
set gRY[QfP]=0.
set IRY[QfP]=0
set mRY[bfP]=afP
set FRY[bfP]=DfP
set vfP=wPk("bar-active.dds")
set FfP=vfP
call BlzFrameSetSize(FfP,0.,OHR(FfP))
set pfP=vfP
set gfP=pfP
call BlzFrameSetSize(gfP,Ejk(gfP),DfP)
set oRY[bfP]=pfP
set VfP=wPk("bar-bg.dds")
set ofP=VfP
call BlzFrameSetSize(ofP,afP,OHR(ofP))
set mfP=VfP
set CfP=mfP
call BlzFrameSetSize(CfP,Ejk(CfP),DfP)
set CRY[bfP]=mfP
set vfP=null
set pfP=null
set VfP=null
set mfP=null
set FfP=null
set gfP=null
set ofP=null
set CfP=null
return ffP
endfunction
function F9G takes real V9G,real m9G returns string
if V9G==kk[0] and m9G==qk[0]then
set yK="Pig Farm"
elseif V9G==kk[1] and m9G==qk[1]then
set yK="Fountain"
elseif V9G==kk[2] and m9G==qk[2]then
set yK="Scout Tower"
elseif V9G==kk[3] and m9G==qk[3]then
set yK="Walking Barracks"
endif
return yK
endfunction
