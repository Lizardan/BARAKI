call SaveReal(kR,cWR,9,UWR)
call SaveReal(kR,cWR,10,YnR)
call SaveReal(kR,cWR,11,GnR)
call SaveReal(kR,cWR,12,RnR)
call SaveReal(kR,cWR,13,knR)
call SaveReal(kR,cWR,14,qnR)
set SWR=null
set lnR=null
return cWR
endfunction
