<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../USS/BarakiTheme.uss" />
    <ui:Style src="../USS/MainMenu.uss" />
    <ui:VisualElement name="MenuScreen" class="ui-screen mm" picking-mode="Position">
        <ui:VisualElement name="MenuBackdrop" class="ui-bg" picking-mode="Ignore" />
        <ui:VisualElement class="mm__ambient mm__ambient--left" picking-mode="Ignore" />
        <ui:VisualElement class="mm__ambient mm__ambient--right" picking-mode="Ignore" />
        <ui:VisualElement class="mm__shade" picking-mode="Ignore" />

        <ui:VisualElement class="mm__shell" picking-mode="Ignore">
            <ui:VisualElement class="mm__header" picking-mode="Ignore">
                <ui:VisualElement name="MenuBrand" class="mm__brand" picking-mode="Ignore">
                    <ui:Label name="TitleLabel" text="BARAKI" class="mm__title" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="VersionBar" class="mm__version-bar" picking-mode="Ignore">
                    <ui:Label name="VersionLabel" text="v0.0.0" class="mm__version-text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="mm__body" picking-mode="Ignore">
                <ui:VisualElement class="mm__main" picking-mode="Position">
                    <ui:VisualElement name="MenuPanel" class="mm__panel">
                        <ui:VisualElement name="ProfileBlock" class="mm__profile-block" picking-mode="Position">
                            <ui:VisualElement name="ProfileBadge" class="mm__profile-badge mm__profile-badge--copyable" picking-mode="Position">
                                <ui:VisualElement name="ProfileAvatar" class="mm__avatar" picking-mode="Ignore">
                                    <ui:Label name="ProfileAvatarLabel" text="?" class="mm__avatar-text" picking-mode="Ignore" />
                                </ui:VisualElement>
                                <ui:VisualElement class="mm__profile-badge-text" picking-mode="Ignore">
                                    <ui:VisualElement name="ProfileNameRow" class="mm__profile-name-row" picking-mode="Ignore">
                                        <ui:Label name="ProfileNameLabel" text="Игрок" class="mm__profile-name" enable-rich-text="true" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                    <ui:Label name="ProfileStatsLabel" text="Ранг — · Очки —" class="mm__profile-stats" picking-mode="Ignore" />
                                    <ui:Label name="ProfileRecordLabel" text="Матчи — · Победы — · Поражения —" class="mm__profile-stats mm__profile-stats--bottom" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Button name="EditProfileButton" text="РЕДАКТИРОВАТЬ" class="mm__profile-edit-btn" />
                        </ui:VisualElement>

                        <ui:Button name="ReturnToMatchButton" text="ВЕРНУТЬСЯ В МАТЧ" class="mm-menu-btn mm__return-btn ui-overlay--hidden" />

                        <ui:VisualElement name="LeftTabHost" class="mm__left-host">
                            <ui:VisualElement name="ChatTabContent" class="mm__left-pane mm__left-pane--chat">
                                <ui:VisualElement name="ChatChannelTabs" class="mm__chat-channel-tabs" picking-mode="Position">
                                    <ui:Button name="ChatGlobalTabButton" text="ОБЩИЙ" class="mm__chat-channel-tab mm__chat-channel-tab--active" />
                                    <ui:Button name="ChatFriendsTabButton" text="СРЕДИ ДРУЗЕЙ" class="mm__chat-channel-tab" />
                                </ui:VisualElement>
                                <ui:Label name="ChatSubtitle" text="Общий канал" class="mm__chat-subtitle" picking-mode="Ignore" />
                                <ui:ScrollView name="ChatGlobalScroll" class="mm-chat-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                                    <ui:VisualElement name="ChatGlobalMessages" class="mm-chat-messages" picking-mode="Ignore" />
                                </ui:ScrollView>
                                <ui:ScrollView name="ChatFriendsScroll" class="mm-chat-scroll mm-chat-scroll--hidden" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                                    <ui:VisualElement name="ChatFriendsMessages" class="mm-chat-messages" picking-mode="Ignore" />
                                </ui:ScrollView>
                                <ui:VisualElement name="ChatComposer" class="mm-chat-composer" picking-mode="Position">
                                    <ui:TextField name="ChatInput" class="mm-chat-input" max-length="280" />
                                    <ui:Button name="ChatSendButton" text="ОТПРАВИТЬ" class="mm-chat-send" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement name="MatchHistoryTabContent" class="mm__left-pane ui-overlay--hidden">
                                <ui:ScrollView name="MatchHistoryScroll" class="mm-chat-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                                    <ui:VisualElement name="MatchHistoryList" class="mm-list" picking-mode="Ignore">
                                        <ui:Label text="История матчей пока пуста." class="mm-empty" picking-mode="Ignore" />
                                        <ui:Label text="Сыгранные бои появятся здесь." class="mm-empty mm-empty--hint" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:ScrollView>
                            </ui:VisualElement>

                            <ui:VisualElement name="PublicGamesTabContent" class="mm__left-pane ui-overlay--hidden">
                                <ui:ScrollView name="PublicGamesScroll" class="mm-chat-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                                    <ui:VisualElement name="PublicGamesList" class="mm-list" picking-mode="Ignore">
                                        <ui:Label text="Публичных игр сейчас нет." class="mm-empty" picking-mode="Ignore" />
                                        <ui:Label text="Открытые комнаты, в которые можно зайти, появятся в этом списке." class="mm-empty mm-empty--hint" picking-mode="Ignore" />
                                    </ui:VisualElement>
                                </ui:ScrollView>
                            </ui:VisualElement>

                            <ui:VisualElement name="SettingsTabContent" class="mm__left-pane ui-overlay--hidden">
                                <ui:Label text="НАСТРОЙКИ" class="mm__left-pane-title" picking-mode="Ignore" />
                                <ui:VisualElement class="ui-dialog__row">
                                    <ui:Label text="Звук" class="ui-label" />
                                    <ui:Toggle name="SoundToggle" class="ui-toggle" />
                                </ui:VisualElement>
                                <ui:VisualElement class="ui-dialog__row ui-dialog__row--stack">
                                    <ui:VisualElement class="ui-dialog__row-head">
                                        <ui:Label text="Громкость" class="ui-label" />
                                        <ui:Label name="VolumeValueLabel" text="75%" class="ui-dialog__value" />
                                    </ui:VisualElement>
                                    <ui:Slider name="VolumeSlider" low-value="0" high-value="1" value="0.75" class="ui-slider" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="LeftTabs" class="mm__dock-tabs">
                            <ui:Button name="ChatTabButton" text="ЧАТ" class="mm__dock-tab mm__dock-tab--active" />
                            <ui:Button name="PublicGamesTabButton" text="ИГРЫ" class="mm__dock-tab" />
                            <ui:Button name="MatchHistoryTabButton" text="ИСТОРИЯ" class="mm__dock-tab" />
                            <ui:Button name="SettingsButton" tooltip="Настройки" class="mm__dock-tab mm__dock-tab--gear">
                                <ui:Label text="⚙" class="mm__dock-gear" picking-mode="Ignore" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="HubPanel" class="mm__side">
                    <ui:VisualElement class="mm__side-inner">
                        <ui:VisualElement name="HubTabs" class="mm__hub-tabs">
                            <ui:Button name="GameTabButton" text="ИГРА" class="mm__friends-tab mm__friends-tab--active" />
                            <ui:Button name="HubFriendsTabButton" class="mm__friends-tab mm__friends-tab--with-count">
                                <ui:Label text="ДРУЗЬЯ" class="mm__hub-tab-title" picking-mode="Ignore" />
                                <ui:Label name="FriendsCountLabel" text="0" class="mm__friends-count" picking-mode="Ignore" />
                            </ui:Button>
                        </ui:VisualElement>

                        <ui:VisualElement name="GameTabContent" class="mm__game-pane">
                            <ui:VisualElement name="ModeGrid" class="mm-modes__grid" />
                            <ui:VisualElement name="ModeDossier" class="mm-mode-dossier">
                                <ui:VisualElement name="ModeDossierPreview" class="mm-mode-dossier__preview" picking-mode="Position" />
                                <ui:VisualElement class="mm-mode-dossier__copy" picking-mode="Ignore">
                                    <ui:Label name="ModeDossierTitle" text="" class="mm-mode-dossier__title" picking-mode="Ignore" />
                                    <ui:Label name="ModeDossierBody" text="" class="mm-mode-dossier__body" picking-mode="Ignore" />
                                    <ui:Label name="ModeDossierNote" text="" class="mm-mode-dossier__note" picking-mode="Ignore" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mm-join-meta">
                                <ui:Label name="ModeSelectErrorLabel" text="" class="ui-meta mm-modes__error ui-overlay--hidden" picking-mode="Ignore" />
                                <ui:Label name="MatchEntryErrorLabel" text="" class="ui-meta mm-join-error ui-overlay--hidden" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="mm__game-actions">
                                <ui:VisualElement class="mm__game-slot">
                                    <ui:Button name="PlayButton" text="В БОЙ" class="ui-btn ui-btn--primary" />
                                    <ui:VisualElement name="JoinCodeRow" class="mm-join-slot ui-overlay--hidden">
                                        <ui:TextField name="JoinCodeField" class="mm-join__field mm-join__field--slot" max-length="8" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="mm__game-slot mm__game-slot--after">
                                    <ui:Button name="JoinMatchButton" text="ПРИСОЕДИНИТЬСЯ" class="ui-btn" />
                                    <ui:Button name="JoinConfirmButton" text="ВОЙТИ" class="ui-btn ui-btn--primary ui-overlay--hidden" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="FriendsHost" class="mm__friends-host ui-overlay--hidden">
                            <ui:VisualElement name="FriendsTabs" class="mm__friends-tabs">
                                <ui:Button name="FriendsTabButton" text="ДРУЗЬЯ" class="mm__friends-tab mm__friends-tab--active" />
                                <ui:Button name="InvitesTabButton" text="ПРИГЛАШЕНИЯ" class="mm__friends-tab" />
                            </ui:VisualElement>
                            <ui:VisualElement name="FriendsTabContent" class="mm__friends-tab-pane">
                                <ui:ScrollView name="FriendsScroll" class="mm__friends-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                                    <ui:VisualElement name="FriendsListContainer" class="mm__friends-list-container" />
                                </ui:ScrollView>
                                <ui:VisualElement name="AddFriendSection" class="mm__friends-add">
                                    <ui:Label name="FriendsErrorLabel" text="" class="ui-meta mm__friends-error ui-overlay--hidden" picking-mode="Ignore" />
                                    <ui:TextField name="FriendIdField" class="mm-join__field" max-length="32" />
                                    <ui:Button name="AddFriendButton" text="ДОБАВИТЬ" class="ui-btn" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="InvitesTabContent" class="mm__friends-tab-pane ui-overlay--hidden">
                                <ui:ScrollView name="InvitesScroll" class="mm__friends-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                                    <ui:VisualElement name="IncomingRequestsList" class="mm__incoming-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="WindowChrome" class="mm-window-chrome" picking-mode="Ignore">
            <ui:Button name="QuitButton" text="✕" tooltip="Выход" class="mm-btn mm-btn--close" />
        </ui:VisualElement>

        <ui:VisualElement name="ProfileEditOverlay" class="ui-overlay ui-overlay--hidden">
            <ui:VisualElement name="ProfileEditDim" class="ui-overlay__dim" />
            <ui:VisualElement name="ProfileEditDialog" class="ui-dialog mm-profile-edit">
                <ui:VisualElement class="ui-dialog__header mm-modes__header">
                    <ui:Label text="ПРОФИЛЬ" class="ui-dialog__title" />
                    <ui:Button name="ProfileEditCloseButton" text="×" class="ui-dialog__close" />
                </ui:VisualElement>
                <ui:VisualElement class="ui-dialog__body mm-profile-edit__body">
                    <ui:Label text="Аватар" class="ui-label mm-profile-edit__label" />
                    <ui:VisualElement name="AvatarGrid" class="mm-profile-edit__avatars" />
                    <ui:Label text="Ник" class="ui-label mm-profile-edit__label" />
                    <ui:TextField name="DisplayNameField" class="mm-join__field" max-length="24" />
                    <ui:Label name="ProfileEditErrorLabel" text="" class="ui-meta mm-modes__error" />
                    <ui:Button name="SaveProfileButton" text="СОХРАНИТЬ" class="ui-btn ui-btn--primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="SettingsOverlay" class="ui-overlay ui-overlay--hidden">
            <ui:VisualElement name="MenuOverlayDim" class="ui-overlay__dim" />
            <ui:VisualElement name="MenuDialog" class="ui-dialog">
                <ui:VisualElement class="ui-dialog__header">
                    <ui:Label text="НАСТРОЙКИ" class="ui-dialog__title" />
                    <ui:Button name="SettingsCloseButton" text="×" class="ui-dialog__close" />
                </ui:VisualElement>
                <ui:VisualElement class="ui-dialog__body">
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="MatchEntryOverlay" class="ui-overlay ui-overlay--hidden">
            <ui:VisualElement name="MatchEntryDim" class="ui-overlay__dim" />
            <ui:VisualElement class="ui-dialog mm-entry">
                <ui:VisualElement class="ui-dialog__header mm-modes__header">
                    <ui:Label text="МАТЧ" class="ui-dialog__title" />
                    <ui:Button name="MatchEntryCloseButton" text="×" class="ui-dialog__close" />
                </ui:VisualElement>
                <ui:VisualElement class="ui-dialog__body mm-entry__body">
                    <ui:Button name="CreateMatchButton" text="СОЗДАТЬ МАТЧ" class="ui-btn ui-btn--primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="LobbyInviteBanner" class="mm__invite-banner ui-overlay--hidden">
            <ui:Label name="LobbyInviteBannerLabel" text="" class="mm__invite-banner__text" />
            <ui:Button name="LobbyInviteJoinButton" text="ВОЙТИ" class="ui-btn ui-btn--primary mm__invite-banner__btn" />
            <ui:Button name="LobbyInviteDismissButton" text="×" class="ui-btn mm__invite-banner__dismiss" />
        </ui:VisualElement>

        <ui:VisualElement name="ModeSelectOverlay" class="ui-overlay ui-overlay--hidden">
            <ui:VisualElement name="ModeSelectDim" class="ui-overlay__dim" />
            <ui:VisualElement class="ui-dialog mm-modes">
                <ui:VisualElement class="ui-dialog__header mm-modes__header">
                    <ui:Label text="РЕЖИМ" class="ui-dialog__title" />
                    <ui:Button name="ModeSelectCloseButton" text="×" class="ui-dialog__close" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="LobbyEntryOverlay" class="ui-overlay ui-panel-loading-overlay--hidden" picking-mode="Position">
            <ui:VisualElement class="ui-overlay__dim" />
            <ui:VisualElement class="ui-dialog mm-lobby-entry">
                <ui:VisualElement class="ui-dialog__body mm-lobby-entry__body">
                    <ui:VisualElement class="ui-panel-loading-overlay__content mm-lobby-entry__line">
                        <ui:Label text="Вход в лобби" class="ui-panel-loading-overlay__text mm-lobby-entry__text" />
                        <ui:Label text="" class="ui-panel-loading-overlay__dots mm-lobby-entry__dots" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
