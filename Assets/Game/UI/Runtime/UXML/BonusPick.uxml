<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Game/UI/Runtime/USS/BonusPick.uss" />
    <ui:Style src="project://database/Assets/Game/UI/Runtime/USS/BarakiTheme.uss" />
    <ui:VisualElement name="BonusPickOverlay" class="bonus-pick" picking-mode="Ignore">
        <ui:VisualElement class="bonus-pick__center" picking-mode="Ignore">
            <ui:VisualElement class="bonus-pick__top" picking-mode="Ignore">
                <ui:Label text="ВЫБОР БОНУСОВ" class="bonus-pick__title" />
                <ui:Label name="BonusPickTimer" text="60" class="bonus-pick__timer" />
            </ui:VisualElement>
            <ui:Label text="Первый бонус уже выбран за вас. Во втором окне выберите один из шести предложенных — матч уже идёт." class="ui-panel__note bonus-pick__status" />
            <ui:VisualElement class="bonus-pick__row" picking-mode="Ignore">
                <ui:VisualElement name="BonusPickAutoPanel" class="ui-chrome bonus-pick__panel">
                    <ui:Label text="СЛУЧАЙНЫЙ БОНУС" class="bonus-pick__panel-title" />
                    <ui:VisualElement name="BonusPickAutoGrid" class="bonus-pick__grid" />
                </ui:VisualElement>
                <ui:VisualElement name="BonusPickOfferPanel" class="ui-chrome bonus-pick__panel">
                    <ui:Label text="ВЫБЕРИ БОНУС" class="bonus-pick__panel-title" />
                    <ui:VisualElement name="BonusPickOfferGrid" class="bonus-pick__grid" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BonusPickTooltip" class="bonus-pick-tooltip bonus-pick-tooltip--hidden" picking-mode="Ignore">
            <ui:Label name="BonusPickTooltipLabel" text="" class="bonus-pick-tooltip__label" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>