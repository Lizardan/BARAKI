set CK=true
elseif GaR=="W" then
set IK=true
elseif GaR=="E" then
set EK=true
endif
elseif UNR==cR[YaR] or UNR==XR[2]then
if GaR=="Q" then
set sK=true
elseif GaR=="W" then
set xK=true
elseif GaR=="E" then
set KK=true
endif
elseif UNR==Gk[YaR] or UNR==XR[3]then
