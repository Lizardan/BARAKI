function xhk takes player bhk,integer Qhk,real vhk,real phk,real Vhk returns nothing
local integer mhk=GetPlayerId(bhk)
local real Fhk=phk+100.*Cos(vhk*bj_DEGTORAD)
local real ghk=Vhk+100.*Sin(vhk*bj_DEGTORAD)
local real ohk=phk+85.*Cos(vhk*bj_DEGTORAD)
local real Chk=Vhk+85.*Sin(vhk*bj_DEGTORAD)
local player Ihk=Player(mhk+4)
local integer Ehk
local integer shk
if Qhk>=1 then
if d[mhk]==$6e7a6f6d then
call CreateUnit(Ihk,d[mhk],Fhk,ghk,vhk)
call CreateUnit(Ihk,d[mhk],Fhk,ghk,vhk)
endif
if tv[mhk]>0 then
if tv[mhk]>=1 then
call CreateUnit(Ihk,$6e303345,ohk,Chk,vhk)
endif
if tv[mhk]>=2 then
call CreateUnit(Ihk,$6e303346,ohk,Chk,vhk)
endif
if tv[mhk]>=3 then
call CreateUnit(Ihk,$6e303347,ohk,Chk,vhk)
endif
endif
call CreateUnit(Ihk,d[mhk],Fhk,ghk,vhk)
call CreateUnit(Ihk,d[mhk],Fhk,ghk,vhk)
call CreateUnit(Ihk,y[mhk],ohk,Chk,vhk)
call CreateUnit(Ihk,J[mhk],ohk,Chk,vhk)
call CreateUnit(Ihk,YY[mhk],ohk,Chk,vhk)
if GetPlayerTechCount(bhk,$52303739,true)>0 then
set Ehk=GetPlayerTechCount(bhk,$52303739,true)
if Ehk>=1 then
call CreateUnit(Ihk,$6e303449,Fhk,ghk,vhk)
endif
if Ehk>=2 then
call CreateUnit(Ihk,$6e30344a,ohk,Chk,vhk)
endif
if Ehk>=3 then
call CreateUnit(Ihk,$6e303449,Fhk,ghk,vhk)
endif
if Ehk>=4 then
call CreateUnit(Ihk,$6e30344a,ohk,Chk,vhk)
endif
endif
endif
if Qhk>=2 then
if S[mhk]==$6e303358 then
call CreateUnit(Ihk,S[mhk],Fhk,ghk,vhk)
else
call CreateUnit(Ihk,S[mhk],Fhk,ghk,vhk)
call CreateUnit(Ihk,S[mhk],Fhk,ghk,vhk)
endif
if d[mhk]==$6e7a6f6d then
call CreateUnit(Ihk,d[mhk],Fhk,ghk,vhk)
endif
call CreateUnit(Ihk,d[mhk],Fhk,ghk,vhk)
endif
if Qhk>=3 then
call CreateUnit(Ihk,y[mhk],ohk,Chk,vhk)
call CreateUnit(Ihk,J[mhk],ohk,Chk,vhk)
call CreateUnit(Ihk,c[mhk],ohk,Chk,vhk)
endif
if Qhk==4 then
call CreateUnit(Ihk,S[mhk],Fhk,ghk,vhk)
if d[mhk]==$6e7a6f6d then
call CreateUnit(Ihk,d[mhk],Fhk,ghk,vhk)
endif
call CreateUnit(Ihk,d[mhk],Fhk,ghk,vhk)
call CreateUnit(Ihk,U[mhk],ohk,Chk,vhk)
endif
if GR[mhk]then
call CreateUnit(Ihk,$6e303457,ohk,Chk,vhk)
endif
set shk=OIl()
set OqY[shk]=mhk
set NqY[shk]=phk
set aqY[shk]=Vhk
call Hpk(.3,shk)
set Ihk=null
endfunction
