.bonus-pick {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(15, 15, 16, 0.45);
}

.bonus-pick__center {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 24px;
}

.bonus-pick__panel {
    /* Same footprint as match-bottom-dock__panel so ui-btn--square keeps barracks proportions. */
    width: 350px;
    min-width: 350px;
    max-width: 350px;
    padding: 8px;
}

.bonus-pick__inner {
    flex-grow: 1;
    justify-content: flex-start;
}

.bonus-pick__title {
    font-size: 13px;
    letter-spacing: 4px;
}

.bonus-pick__timer {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(125, 117, 104);
    letter-spacing: 2px;
    min-width: 48px;
    -unity-text-align: middle-right;
}

.bonus-pick__status {
    margin-bottom: 10px;
}

.bonus-pick__grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
    padding: 0;
}

.bonus-pick__slot {
    /* size from ui-btn--square (same as match-command-grid__slot) */
    overflow: hidden;
    position: relative;
}

.ui-btn--square.bonus-pick__slot {
    border-width: 1px;
    border-color: rgb(75, 77, 69);
    background-color: rgb(28, 30, 27);
    padding: 0;
    margin: 0 8px 8px 0;
    width: 105.33px;
    height: 77px;
}

.ui-btn--square.bonus-pick__slot:hover {
    background-color: rgb(36, 39, 35);
    border-color: rgb(185, 154, 98);
}

.bonus-pick__slot--picked {
    opacity: 1;
    background-color: rgb(36, 39, 35);
    border-color: rgb(185, 154, 98);
}

.bonus-pick__slot--picked.bonus-pick__slot--locked {
    opacity: 1;
}

.bonus-pick__slot--locked {
    opacity: 0.72;
}

.bonus-pick__portrait {
    position: absolute;
    left: 3.5px;
    top: 3.5px;
    right: 3.5px;
    bottom: 3.5px;
    picking-mode: ignore;
    background-color: rgba(0, 0, 0, 0);
    background-size: cover;
    -unity-background-scale-mode: scale-and-crop;
    background-position-x: 50%;
    background-position-y: 0%;
    overflow: hidden;
}

.bonus-pick-tooltip {
    position: absolute;
    max-width: 240px;
    padding: 8px 10px;
    background-color: rgba(9, 9, 10, 0.96);
    border-width: 2px;
    border-color: rgba(125, 117, 104, 0.55);
    z-index: 1000;
}

.bonus-pick-tooltip--hidden {
    display: none;
}

.bonus-pick-tooltip__label {
    font-size: 12px;
    color: rgb(239, 228, 207);
    white-space: normal;
    -unity-text-align: middle-left;
}

.bonus-pick--hidden {
    display: none;
}

/* Bonus grid: last column no right margin, last row no bottom margin (3×4 grid) */
#BonusSlot7,
#BonusSlot1,
#BonusSlot4,
#BonusSlot12 {
    margin-right: 0;
}

#BonusSlot5,
#BonusSlot6,
#BonusSlot12 {
    margin-bottom: 0;
}
