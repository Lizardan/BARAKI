/* BARAKI launcher v9 - hero plus news rail */

.bl {
    background-color: rgb(14, 14, 16);
}

.bl__bg {
    background-color: rgb(8, 8, 10);
}

.bl__ambient {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 46%;
    opacity: 0.72;
}

.bl__ambient--fire {
    left: -6%;
    background-color: rgba(125, 117, 104, 0.08);
}

.bl__ambient--ice {
    right: -8%;
    background-color: rgba(74, 158, 255, 0.05);
}

.bl__shade {
    background-color: rgba(8, 8, 10, 0.16);
}

.bl__vignette {
    border-left-width: 28px;
    border-right-width: 28px;
    border-top-width: 28px;
    border-bottom-width: 28px;
    border-color: rgba(0, 0, 0, 0.52);
}

.bl__shell {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 24px;
    bottom: 24px;
    flex-direction: column;
}

.bl__content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
    gap: 22px;
}

.bl__main-stack {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    gap: 22px;
}

.bl__hero {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    height: auto;
}

.bl__side {
    width: 300px;
    flex-shrink: 0;
    flex-direction: column;
}

.bl__hero-inner {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    padding: 34px;
    background-color: rgba(10, 10, 12, 0.7);
}

.bl__hero-copy {
    flex-grow: 1;
    justify-content: flex-start;
    align-items: flex-start;
}

.bl__hero-kicker {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(125, 117, 104);
    letter-spacing: 6px;
    margin-bottom: 18px;
}

.bl__hero-title {
    max-width: 560px;
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(239, 228, 207);
    white-space: normal;
    margin-bottom: 14px;
    text-shadow: 0 3px 16px rgba(0, 0, 0, 0.82);
}

.bl__hero-body {
    max-width: 500px;
    font-size: 15px;
    color: rgba(198, 186, 154, 0.92);
    white-space: normal;
    margin-bottom: 18px;
}

.bl__chat-room {
    width: 100%;
    max-width: 620px;
    margin-bottom: 20px;
}

.bl__chat-message {
    margin-bottom: 12px;
    padding: 12px 14px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.05);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.bl__chat-message--self {
    margin-left: 54px;
    background-color: rgba(74, 158, 255, 0.12);
    border-color: rgba(74, 158, 255, 0.12);
}

.bl__chat-author {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(125, 117, 104);
    letter-spacing: 2px;
    margin-bottom: 6px;
}

.bl__chat-text {
    font-size: 14px;
    color: rgb(239, 228, 207);
    white-space: normal;
}

.bl__hero-metrics {
    flex-direction: row;
    flex-wrap: wrap;
}

.bl__hero-chip {
    margin-right: 10px;
    margin-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(239, 228, 207);
    background-color: rgba(34, 34, 36, 0.9);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(125, 117, 104, 0.38);
}

.bl__hero-bottom {
    display: none;
}

.bl__launcher {
    flex-shrink: 0;
    min-height: 164px;
    max-height: 164px;
}

.bl__launcher-inner {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    padding: 18px;
    background-color: rgba(10, 10, 12, 0.76);
}

.bl__status-dock {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-bottom: 0;
    margin-right: 18px;
    justify-content: center;
}

.bl__status-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    min-height: 18px;
}

.bl__status-tag {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(125, 117, 104);
    letter-spacing: 2px;
    margin-right: 10px;
}

.bl__version-text {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(184, 169, 130, 0.76);
    letter-spacing: 1px;
}

.bl__status-text {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(184, 169, 130, 0.92);
    white-space: nowrap;
    margin-bottom: 0;
    min-height: 18px;
    flex-grow: 1;
}

.bl__status-text-row {
    flex-direction: row;
    align-items: center;
    min-height: 18px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.bl__status-inline {
    min-width: 44px;
    margin-right: 10px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(184, 169, 130, 0.92);
    letter-spacing: 1px;
}

.bl__status-foot {
    flex-direction: row;
    align-items: center;
    min-height: 18px;
    max-height: 18px;
}

.bl__update-meta {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
    margin-bottom: 0;
    min-height: 20px;
}

.bl__slot--inactive {
    visibility: hidden;
    opacity: 0;
}

.bl__range {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
}

.bl__range-part,
.bl__range-arrow {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(125, 117, 104);
}

.bl__range-part--remote {
    color: rgb(74, 158, 255);
}

.bl__range-arrow {
    margin-left: 6px;
    margin-right: 6px;
}

.bl__update-error {
    font-size: 11px;
    color: rgb(220, 120, 100);
    white-space: normal;
    flex-grow: 1;
}

.bl__action-dock {
    width: 168px;
    flex-shrink: 0;
    min-width: 168px;
    max-width: 168px;
    height: 100%;
    align-self: stretch;
}

.bl__action-dock-inner {
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
}

.bl__cta-slot {
    position: relative;
    width: 100%;
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    flex-shrink: 0;
    margin-right: 0;
    margin-bottom: 0;
    overflow: hidden;
}

.bl__idle-cta,
.bl__action-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
}

.bl__idle-cta {
    align-items: stretch;
    justify-content: center;
    background-color: rgba(24, 24, 27, 0.96);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgb(94, 88, 78);
    border-radius: 0;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: 56px;
    max-height: 56px;
    padding-left: 0;
    padding-right: 0;
    overflow: hidden;
    flex-shrink: 0;
}

.bl__idle-cta-label {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgba(184, 169, 130, 0.88);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    align-self: stretch;
}

.ui-btn.bl__cta {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(239, 228, 207);
    background-color: rgb(86, 103, 122);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgb(125, 117, 104);
    border-radius: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 0;
    scale: 1;
}

.ui-btn.bl__cta:hover {
    background-color: rgb(96, 116, 138);
    border-color: rgb(125, 117, 104);
    scale: 1;
}

.ui-btn.bl__cta.bl__cta--update,
.ui-btn.bl__cta.bl__cta--update:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(88, 204, 104);
    border-color: rgb(125, 117, 104);
}

.ui-btn.bl__cta.ui-btn--muted,
.ui-btn.bl__cta.ui-btn--muted:hover {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 14px;
    letter-spacing: 1px;
    color: rgba(184, 169, 130, 0.88);
    background-color: rgb(24, 24, 27);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgb(94, 88, 78);
    border-radius: 0;
    scale: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 0;
}

.bl__cta-host {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 56px;
    max-height: 56px;
}

.bl__progress-shell {
    margin-top: 26px;
    height: 12px;
}

.bl__progress-track {
    position: relative;
    width: 100%;
    height: 12px;
    background-color: rgb(52, 52, 56);
    overflow: hidden;
}

.bl__progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: rgb(88, 204, 104);
}

.ui-btn.bl__cta.bl__cta--downloading {
    color: rgb(239, 228, 207);
    background-color: rgb(86, 103, 122);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgb(125, 117, 104);
}

.ui-btn.bl__cta.bl__cta--downloading:hover {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(125, 117, 104);
    scale: 1;
}

.ui-btn.bl__quit {
    margin-top: 0;
}

.bl__rail {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-bottom: 0;
}

.bl__rail-inner {
    flex-grow: 1;
    flex-direction: column;
    padding: 22px;
    background-color: rgba(9, 9, 11, 0.82);
    min-height: 0;
}

.bl__rail-head {
    flex-shrink: 0;
    margin-bottom: 14px;
}

.bl__rail-kicker {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(125, 117, 104);
    letter-spacing: 3px;
    margin-bottom: 8px;
}

.bl__rail-featured {
    flex-direction: column;
    padding: 16px;
    background-color: rgba(24, 24, 27, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 0;
}

.bl__rail-featured-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(239, 228, 207);
    white-space: normal;
    margin-bottom: 8px;
}

.bl__rail-featured-body {
    font-size: 12px;
    color: rgba(184, 169, 130, 0.95);
    white-space: normal;
}

.bl__rail-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.bl__news-list {
    flex-direction: column;
}

.bl__news-card {
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 12px 14px;
    background-color: rgba(30, 30, 33, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 0;
}

.bl__news-card--last {
    margin-bottom: 0;
}

.bl__news-card__tag {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(125, 117, 104);
    letter-spacing: 2px;
    margin-bottom: 6px;
}

.bl__news-card__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(239, 228, 207);
    margin-bottom: 6px;
    white-space: normal;
}

.bl__news-card__body {
    font-size: 11px;
    color: rgba(184, 169, 130, 0.95);
    white-space: normal;
}

.bl__sr {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
}
