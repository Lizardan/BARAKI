/* Арена: таймер вверху по центру, выбор бойца, презентация дуэли, результат. */

.arena-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-grow: 1;
}

/* ── Таймер до арены (по центру верхней полоски HUD) ────────────── */

/*
 * Раскладка верхней полоски: время матча слева, таймер арены по центру, золото справа.
 * Абсолютное позиционирование выводит ряд из потока TopBar, поэтому он не сдвигает
 * крайние элементы, а растягивается на всю ширину полоски и центрирует содержимое
 * через justify-content.
 */
.arena-hud__timer-row {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.arena-hud__timer-row--hidden {
    display: none;
}

.arena-hud__timer-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(222, 219, 210);
    -unity-text-align: middle-left;
}

.arena-hud__timer-caption {
    margin-left: 10px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(133, 137, 128);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

/* ── Оверлей выбора бойца ──────────────────────────────────────── */

.arena-pick {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 9, 8, 0.82);
}

.arena-pick--hidden {
    display: none;
}

.arena-pick__panel {
    min-width: 420px;
    max-width: 720px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 20px;
    align-items: center;
}

.arena-pick__title {
    color: rgb(185, 154, 98);
    -unity-text-align: middle-center;
}

.arena-pick__reward {
    margin-top: 4px;
    font-size: 14px;
    color: rgb(222, 219, 210);
    -unity-text-align: middle-center;
}

.arena-pick__timer {
    margin-top: 8px;
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(222, 219, 210);
    -unity-text-align: middle-center;
}

.arena-pick__hint {
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.arena-pick__list {
    margin-top: 12px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

/* Герои арены — ровно в ряд (как в меню очерёдности после бонусов), без переноса.
   Выбор соперника (несколько игроков) по-прежнему переносится. */
.arena-pick__list--heroes {
    flex-wrap: nowrap;
}

.arena-pick__option {
    width: 120px;
    height: 132px;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 6px;
    margin-bottom: 6px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgb(21, 23, 22);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(52, 56, 50);
}

.arena-pick__option:hover {
    border-color: rgb(185, 154, 98);
}

.arena-pick__option--selected {
    border-color: rgb(185, 154, 98);
    background-color: rgb(38, 32, 22);
}

.arena-pick__option--locked {
    opacity: 0.35;
}

.arena-pick__option--locked:hover {
    border-color: rgb(52, 56, 50);
}

.arena-pick__option-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(222, 219, 210);
    -unity-text-align: middle-center;
}

.arena-pick__option-meta {
    margin-top: 4px;
    font-size: 12px;
    color: rgb(133, 137, 128);
    -unity-text-align: middle-center;
}

/* ── Карточки героев (idle-превью как в меню очерёдности) ────────── */

.arena-pick__card {
    width: 124px;
    height: 158px;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 6px;
    margin-bottom: 6px;
    flex-direction: column;
    align-items: center;
    background-color: rgb(21, 23, 22);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(52, 56, 50);
}

.arena-pick__card:hover {
    border-color: rgb(185, 154, 98);
}

.arena-pick__card--selected {
    border-color: rgb(185, 154, 98);
    background-color: rgb(38, 32, 22);
}

.arena-pick__card--locked {
    opacity: 0.38;
}

.arena-pick__card--locked:hover {
    border-color: rgb(52, 56, 50);
}

.arena-pick__preview {
    width: 100%;
    height: 104px;
    margin-top: 4px;
    background-color: rgb(12, 13, 12);
    -unity-background-scale-mode: stretch-to-fill;
}

.arena-pick__card-title {
    margin-top: 6px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(222, 219, 210);
    -unity-text-align: middle-center;
}

.arena-pick__card-meta {
    margin-top: 2px;
    font-size: 12px;
    color: rgb(133, 137, 128);
    -unity-text-align: middle-center;
}

.arena-pick__opponent-title {
    margin-top: 16px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(185, 154, 98);
    -unity-text-align: middle-center;
}

.arena-pick__opponent-title--hidden {
    display: none;
}

/* ── Презентация пары (5 секунд) ───────────────────────────────── */

.arena-intro {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.arena-intro--hidden {
    display: none;
}

.arena-intro__title {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(222, 219, 210);
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 rgb(8, 9, 8);
}

.arena-intro__timer {
    margin-top: 8px;
    font-size: 20px;
    color: rgb(185, 154, 98);
    -unity-text-align: middle-center;
}

/* ── Полосы здоровья во время дуэли ────────────────────────────── */

.arena-duel {
    position: absolute;
    left: 0;
    right: 0;
    top: 84px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.arena-duel--hidden {
    display: none;
}

.arena-duel__side {
    width: 260px;
    flex-direction: column;
    align-items: center;
}

.arena-duel__name {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(222, 219, 210);
    -unity-text-align: middle-center;
}

.arena-duel__bar {
    margin-top: 4px;
    width: 240px;
    height: 10px;
    background-color: rgb(8, 9, 8);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(52, 56, 50);
}

.arena-duel__fill {
    width: 100%;
    height: 100%;
    background-color: rgb(154, 66, 56);
}

.arena-duel__vs {
    margin-left: 16px;
    margin-right: 16px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(185, 154, 98);
}

/* ── Итог дуэли ────────────────────────────────────────────────── */

.arena-result {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 120px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.arena-result--hidden {
    display: none;
}

.arena-result__title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(222, 219, 210);
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 rgb(8, 9, 8);
}

.arena-result__reward {
    margin-top: 6px;
    font-size: 18px;
    color: rgb(185, 154, 98);
    -unity-text-align: middle-center;
}
