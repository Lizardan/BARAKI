.bonus-pick {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 9, 8, 0.82);
}

.bonus-pick__center {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 24px;
}

.ui-chrome.bonus-pick__panel {
    width: 350px;
    min-width: 350px;
    max-width: 350px;
    padding: 8px;
    background-color: rgb(16, 18, 17);
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    border-radius: 0;
}

.bonus-pick__inner {
    flex-grow: 1;
    justify-content: flex-start;
}

.ui-panel__header {
    height: auto;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    padding-bottom: 0;
    border-bottom-width: 0;
}

.ui-panel__header-text.bonus-pick__title {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(185, 154, 98);
    -unity-text-align: middle-left;
}

.bonus-pick__timer {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(185, 154, 98);
    letter-spacing: 2px;
    min-width: 48px;
    -unity-text-align: middle-right;
}

.ui-panel__note.bonus-pick__status {
    font-size: 12px;
    color: rgb(133, 137, 128);
    margin-bottom: 8px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.bonus-pick__grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
    padding: 0;
}

.bonus-pick__slot {
    /* size from ui-btn--square (same as match-command-grid__slot) */
    overflow: hidden;
    position: relative;
}

.ui-btn--square.bonus-pick__slot {
    border-width: 1px;
    border-color: rgb(75, 77, 69);
    background-color: rgb(28, 30, 27);
    padding: 0;
    margin: 1%;
    width: 31%;
    height: 77px;
    min-height: 77px;
    max-height: 77px;
    min-width: 0;
    flex-shrink: 0;
    overflow: hidden;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 11px;
    letter-spacing: 1px;
    scale: 1;
}

.ui-btn--square.bonus-pick__slot:hover {
    background-color: rgb(36, 39, 35);
    border-color: rgb(185, 154, 98);
    scale: 1;
}

.bonus-pick__slot--picked {
    opacity: 1;
    background-color: rgb(36, 39, 35);
    border-color: rgb(185, 154, 98);
}

.bonus-pick__slot--picked.bonus-pick__slot--locked {
    opacity: 1;
}

.bonus-pick__slot--locked {
    opacity: 0.72;
}

.bonus-pick__portrait {
    position: absolute;
    left: 3.5px;
    top: 3.5px;
    right: 3.5px;
    bottom: 3.5px;
    picking-mode: ignore;
    background-color: rgba(0, 0, 0, 0);
    background-size: cover;
    -unity-background-scale-mode: scale-and-crop;
    background-position-x: 50%;
    background-position-y: 0%;
    overflow: hidden;
}

.bonus-pick-tooltip {
    position: absolute;
    max-width: 240px;
    padding: 8px 10px;
    background-color: rgb(21, 23, 22);
    border-width: 1px;
    border-color: rgb(52, 56, 50);
    border-radius: 0;
    z-index: 1000;
}

.bonus-pick-tooltip--hidden {
    display: none;
}

.bonus-pick-tooltip__label {
    font-size: 12px;
    color: rgb(222, 219, 210);
    white-space: normal;
    -unity-text-align: middle-left;
}

.bonus-pick--hidden {
    display: none;
}
