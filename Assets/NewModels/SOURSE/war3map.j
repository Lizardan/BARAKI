function cZR takes integer XZR,framehandle dZR returns nothing
local integer yZR=XZR
local framehandle JZR=dZR
local boolean SZR=false
if JZR==null then
if ZH then
call fYZ("Ignoring TableLayout.add() on "+VRY[yZR]+" because the frame is null.")
endif
set SZR=true
endif
if not SZR then
if ikZ(ORY[yZR]) then
if not SZR then
call PkZ(yZR)
endif
endif
endif
if not SZR then
set uRY[yZR]=yuR(Omk(ORY[yZR]),JZR)
endif
set JZR=null
endfunction
