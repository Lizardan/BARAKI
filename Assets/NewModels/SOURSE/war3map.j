function FOw takes integer vOw returns framehandle
local integer pOw
local integer VOw
local integer mOw
set IRY[vOw]=nMq(mRY[vOw]+.002,FRY[vOw],"uibar #"+UIP(vOw))
set NRY[IRY[vOw]]=0.
set aRY[IRY[vOw]]=0.
set DRY[IRY[vOw]]=0.
set fRY[IRY[vOw]]=0.
set pOw=IRY[vOw]
call PkZ(pOw)
set VOw=pOw
call cZR(VOw,oRY[vOw])
set mOw=VOw
call cZR(mOw,CRY[vOw])
return xEq(mOw,wH)
endfunction
function Hiw takes integer Kiw returns framehandle
local framehandle Miw=FOw(Kiw)
set WIY=Miw
set Miw=null
return WIY
endfunction
