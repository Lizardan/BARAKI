set cjk=kk[1]
set Ujk=qk[1]
call SetUnitPosition(Sjk,cjk,Ujk)
set YLk=UR[xjk]
call ShowUnit(YLk,true)
set Mjk=rZP()
set uYY[Mjk]=xjk
call Hpk(.2,Mjk)
