function oFw takes player vFw,integer pFw returns nothing
local integer VFw=N1G(vFw)
local string mFw
local integer FFw
local player gFw
if VFw<0 or VFw>=12 then
set mFw="MMD Flag Error: Invalid player. Must be P1 to P12."
set FFw=0
loop
call DisplayTimedTextToPlayer(Player(FFw),0.,0.,60.,mFw)
set FFw=FFw+1
exitwhen FFw==bj_MAX_PLAYERS
endloop
endif
if GetPlayerController(aE[VFw])==MAP_CONTROL_USER then
set gFw=vFw
call JXw(i8P("FlagP {0} {1}",UIP(N1G(gFw)),LAZ(pFw)))
endif
set gFw=null
endfunction
function gPw takes string DPw,string fPw returns framehandle
local framehandle bPw=jgw(DPw,wH,0,0)
local framehandle QPw=bPw
local string vPw=fPw
local framehandle pPw
local framehandle VPw
local textaligntype mPw
local textaligntype FPw
call BlzFrameSetText(QPw,vPw)
set pPw=bPw
set VPw=pPw
set mPw=TEXT_JUSTIFY_CENTER
set FPw=TEXT_JUSTIFY_CENTER
call BlzFrameSetTextAlignment(VPw,mPw,FPw)
set eIY=pPw
set bPw=null
set QPw=null
set pPw=null
set VPw=null
set mPw=null
set FPw=null
return eIY
endfunction
function owk takes string gwk returns framehandle
return gPw("h3",gwk)
endfunction
function p1k takes string N1k,string a1k,string D1k,string f1k,string b1k returns string
local string v1k=lAk(N1k,"{"+UIP(0)+"}",a1k)
