function uqk takes group Pqk,real Zqk,real lqk,boolean eqk returns unit
local real Bqk=99999.
local unit iqk=null
local group Tqk
local unit jqk
local real Lqk
local real Wqk
local real nqk
local group rqk
local group tqk
local boolean hqk
if eqk then
set Tqk=CreateGroup()
set rqk=Pqk
set tqk=Tqk
set hqk=bj_wantDestroyGroup
set bj_wantDestroyGroup=false
set bj_groupAddGroupDest=tqk
call ForGroup(rqk,function GroupAddGroupEnum)
if hqk then
call DestroyGroup(rqk)
endif
else
set Tqk=Pqk
endif
loop
set jqk=FirstOfGroup(Tqk)
exitwhen jqk==null
set Wqk=GetUnitX(jqk)
set nqk=GetUnitY(jqk)
set Lqk=UkG(Wqk,nqk,Zqk,lqk)
if Lqk<Bqk then
set iqk=jqk
set Bqk=Lqk
endif
call GroupRemoveUnit(Tqk,jqk)
endloop
if eqk then
call DestroyGroup(Tqk)
endif
set G=iqk
set iqk=null
set Tqk=null
set jqk=null
set rqk=null
set tqk=null
return G
endfunction
function qXG takes unit dAG,group yAG returns unit
