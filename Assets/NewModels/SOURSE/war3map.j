call Hpk(.2,Hjk)
elseif sjk==Gk[xjk] and(not ZG) then
set wLk=Gk[xjk]
set PLk=kk[3]
set ZLk=qk[3]
call SetUnitPosition(wLk,PLk,ZLk)
set lLk=Gk[xjk]
call ShowUnit(lLk,true)
set Ajk=mEw()
set NYY[Ajk]=xjk
call Hpk(.2,Ajk)
endif
