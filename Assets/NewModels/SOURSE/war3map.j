local real GuR
local real RuR
local real kuR
local real quR
local real wuR
local real PuR
local real ZuR
local real luR
local real euR
local real BuR
local real iuR
if bRY[xtR]==null then
if ZH then
call fYZ("Ignoring TableLayout.layout() on "+VRY[xtR]+" because no base frame was applied yet.")
endif
set XhR=true
endif
if not XhR then
set dhR=fRY[xtR]
set yhR=-NRY[xtR]
set KtR=dhR
set MtR=yhR
endif
if not XhR then
set HtR=vRY[xtR]-dgP(NRY[xtR],aRY[xtR],DRY[xtR],fRY[xtR])
endif
if not XhR then
if HtR<0. then
if not XhR then
set HtR=0.
endif
endif
endif
if not XhR then
set AtR=0
endif
if not XhR then
set XtR=OpZ(ORY[xtR])
endif
if not XhR then
loop
exitwhen XhR or((not XhR)and(not l4Z(XtR)))
if not XhR then
set dtR=Y2Z(XtR)
endif
if not XhR then
set UtR=dtR
set YhR=HtR
set GhR=UtR
set RhR=YhR
set tRY[GhR]=0.
set hRY[GhR]=0.
set khR=0
set qhR=0.
set whR=0.
set PhR=OpZ(nRY[GhR])
loop
exitwhen not l4Z(PhR)
set ZhR=Y2Z(PhR)
set BhR=ZhR
set ihR=BhR
set lRY[ihR]=Ejk(BRY[ihR])
set eRY[ihR]=OHR(BRY[ihR])
if iRY[ZhR]then
set khR=khR+1
set whR=whR+dgP(TRY[ZhR],jRY[ZhR],LRY[ZhR],WRY[ZhR])
else
set whR=whR+lRY[ZhR]+dgP(TRY[ZhR],jRY[ZhR],LRY[ZhR],WRY[ZhR])
endif
endloop
call FMZ(PhR)
if khR>0 then
set qhR=(RhR-whR)/khR
if qhR<0. then
set qhR=0.
endif
set hRY[GhR]=RhR
endif
set lhR=OpZ(nRY[GhR])
loop
exitwhen not l4Z(lhR)
set ehR=Y2Z(lhR)
if iRY[ehR]then
set ThR=BRY[ehR]
set jhR=qhR
call BlzFrameSetSize(ThR,jhR,OHR(ThR))
endif
set LhR=ehR
set WhR=LhR
set lRY[WhR]=Ejk(BRY[WhR])
set eRY[WhR]=OHR(BRY[WhR])
if eRY[ehR]+i7k(TRY[ehR],jRY[ehR],LRY[ehR],WRY[ehR])>tRY[GhR]then
set tRY[GhR]=eRY[ehR]+i7k(TRY[ehR],jRY[ehR],LRY[ehR],WRY[ehR])
endif
if khR==0 then
set hRY[GhR]=hRY[GhR]+lRY[ehR]+dgP(TRY[ehR],jRY[ehR],LRY[ehR],WRY[ehR])
endif
endloop
call FMZ(lhR)
endif
if not XhR then
if HtR==0. then
if not XhR then
set JtR=1.
endif
elseif not XhR then
set JtR=hRY[dtR]/HtR
endif
endif
if not XhR then
set ytR=JtR
endif
if not XhR then
if ZH and ytR>1. then
if not XhR then
call fYZ("Row #"+UIP(AtR)+" width: "+U7k(hRY[dtR])+" exceeding table "+VRY[xtR]+" availableSpace "+U7k(HtR)+" width: "+U7k(vRY[xtR]))
endif
endif
endif
if not XhR then
set StR=(1.-ytR)*HtR
endif
if not XhR then
set ctR=rRY[dtR]
endif
if not XhR then
if ctR==3 then
elseif not XhR then
if ctR==0 then
if not XhR then
set KtR=fRY[xtR]
endif
elseif not XhR then
if ctR==1 then
if not XhR then
set KtR=fRY[xtR]+StR/2.
endif
elseif not XhR then
set KtR=fRY[xtR]+StR
endif
endif
endif
endif
if not XhR then
set nhR=dtR
set rhR=bRY[xtR]
set JhR=KtR
set ShR=MtR
set thR=JhR
set hhR=ShR
set uhR=nhR
set OhR=rhR
set chR=thR
set UhR=hhR
set NhR=chR
set ahR=UhR
set YuR=NhR
set DhR=YuR
set bhR=OpZ(nRY[uhR])
loop
exitwhen not l4Z(bhR)
set QhR=Y2Z(bhR)
set fhR=ahR
set GuR=XTk(DhR,fhR,WRY[QhR],-TRY[QhR])
set RuR=BPY
set DhR=GuR
set fhR=RuR
set vhR=QhR
set phR=OhR
set kuR=DhR
set quR=fhR
set VhR=kuR
set mhR=quR
set FhR=vhR
set ghR=phR
set wuR=VhR
set PuR=mhR
set ohR=wuR
set ChR=PuR
set IhR=BRY[FhR]
set EhR=ghR
call BlzFrameSetParent(IhR,EhR)
set shR=BRY[FhR]
set xhR=FRAMEPOINT_TOPLEFT
set KhR=ghR
set MhR=FRAMEPOINT_TOPLEFT
set ZuR=ohR
set luR=ChR
set HhR=ZuR
set AhR=luR
call BlzFrameSetPoint(shR,xhR,KhR,MhR,HhR,AhR)
set euR=XTk(DhR,fhR,lRY[QhR]+jRY[QhR],0.)
set DhR=euR
endloop
call FMZ(bhR)
endif
if not XhR then
set BuR=HgZ(KtR,MtR,0.,tRY[dtR])
set iuR=MwY
set KtR=BuR
set MtR=iuR
endif
if not XhR then
set AtR=AtR+1
endif
endloop
endif
if not XhR then
call FMZ(XtR)
endif
set ThR=null
set rhR=null
set OhR=null
set phR=null
set ghR=null
set IhR=null
set EhR=null
set shR=null
set xhR=null
set KhR=null
set MhR=null
endfunction
function pRR takes integer tRR,framehandle hRR returns nothing
local framehandle NRR=null
local framehandle aRR=null
local integer uRR=tRR
local framehandle ORR=hRR
local boolean vRR=false
local framehandle DRR
local real fRR
local framehandle bRR
local real QRR
if ORR==null then
if ZH then
call fYZ("Ignoring TableLayout.applyTo() on "+VRY[uRR]+" because the base frame is null.")
endif
set vRR=true
endif
if not vRR then
set bRY[uRR]=ORR
endif
if not vRR then
set NRR=ORR
endif
if not vRR then
set DRR=NRR
set fRR=vRY[uRR]
call BlzFrameSetSize(DRR,fRR,OHR(DRR))
endif
if not vRR then
set aRR=NRR
endif
if not vRR then
set bRR=aRR
set QRR=pRY[uRR]
call BlzFrameSetSize(bRR,Ejk(bRR),QRR)
endif
if not vRR then
call TuR(uRR)
endif
set ORR=null
set NRR=null
set aRR=null
set DRR=null
set bRR=null
endfunction
function LMk takes integer iMk,framehandle TMk returns framehandle
local framehandle jMk=QgZ(TMk)
call pRR(iMk,jMk)
set BIY=jMk
set jMk=null
return BIY
endfunction
function xEq takes integer IEq,framehandle EEq returns framehandle
