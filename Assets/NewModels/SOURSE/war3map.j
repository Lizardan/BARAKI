function HFk takes nothing returns integer
local integer MFk
if HS==0 then
if AS<JASS_MAX_ARRAY_SIZE then
set AS=AS+1
set MFk=AS
set XS[MFk]=$4b5
else
set MFk=0
endif
else
set HS=HS-1
set MFk=MS[HS]
set XS[MFk]=$4b5
endif
return MFk
endfunction
function ygR takes nothing returns integer
local integer dgR
if oU==0 then
if CU<JASS_MAX_ARRAY_SIZE then
