set CDZ=vDZ
endif
if not JDZ then
call hWk(CDZ,FDZ,false)
endif
if not JDZ then
set IDZ=CDZ
endif
if not JDZ then
call pbw(IDZ,FDZ)
endif
endif
endif
if not JDZ then
set mDZ=mDZ-1
endif
endloop
endif
if not JDZ then
