{
	"name": "uniotasks",
	"displayName": "UnioTasks",
	"description": "Задачи GitHub в сайдбаре: клик по issue запускает opencode; выполненные уходят в закрытые",
	"version": "1.0.4",
	"publisher": "UnioGames",
	"private": true,
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "uniogames-tasks",
					"title": "UnioTasks",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"uniogames-tasks": [
				{
					"id": "uniogamesTasks.taskList",
					"name": "Задачи"
				},
				{
					"id": "uniogamesTasks.recentSessions",
					"name": "Последние сессии"
				},
				{
					"id": "uniogamesTasks.quickPrompt",
					"name": "Новая задача",
					"type": "webview"
				}
			]
		},
		"commands": [
			{
				"command": "uniotasks.launchIssue",
				"title": "UnioTasks: Запустить issue в opencode",
				"icon": "$(play-circle)"
			},
			{
				"command": "uniotasks.resumeLastTask",
				"title": "Открыть последнюю сессию opencode",
				"icon": "$(history)"
			},
			{
				"command": "uniotasks.refresh",
				"title": "Обновить список задач",
				"icon": "$(refresh)"
			},
			{
				"command": "uniotasks.startTask",
				"title": "Запустить выбранную задачу в opencode",
				"icon": "$(play)"
			},
			{
				"command": "uniotasks.resumeTask",
				"title": "Открыть сессию opencode этой задачи (без нового промта)",
				"icon": "$(terminal)"
			},
			{
				"command": "uniotasks.doneTask",
				"title": "Апрув: закрыть задачу и сессию",
				"icon": "$(check)"
			},
			{
				"command": "uniotasks.closeTask",
				"title": "Закрыть выбранный issue",
				"icon": "$(close)"
			},
			{
				"command": "uniotasks.previewIssue",
				"title": "Предпросмотр задачи (markdown как на GitHub)",
				"icon": "$(book)"
			},
			{
				"command": "uniotasks.refreshSummary",
				"title": "Анализ проекта и выбор следующей задачи",
				"icon": "$(sparkle)"
			},
			{
				"command": "uniotasks.restoreAllSessions",
				"title": "UnioTasks: Восстановить все сессии opencode",
				"icon": "$(sync)"
			},
			{
				"command": "uniotasks.resumeSession",
				"title": "Открыть сессию opencode",
				"icon": "$(terminal)"
			},
			{
				"command": "uniotasks.setLabels",
				"title": "Изменить метки задачи",
				"icon": "$(tag)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "uniotasks.launchIssue",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "uniotasks.startTask",
					"when": "view == uniogamesTasks.taskList && viewItem =~ /^issue:(ready):/",
					"group": "inline@1"
				},
				{
					"command": "uniotasks.resumeTask",
					"when": "view == uniogamesTasks.taskList && viewItem =~ /^issue:(running|review):/",
					"group": "inline@2"
				},
				{
					"command": "uniotasks.doneTask",
					"when": "view == uniogamesTasks.taskList && viewItem =~ /^issue:review:/",
					"group": "inline@3"
				},
				{
					"command": "uniotasks.closeTask",
					"when": "view == uniogamesTasks.taskList && viewItem =~ /^issue:(ready|running):/",
					"group": "inline@4"
				},
				{
					"command": "uniotasks.setLabels",
					"when": "view == uniogamesTasks.taskList && viewItem =~ /^issue:/",
					"group": "inline@5"
				}
			]
		},
		"keybindings": [
			{
				"command": "uniotasks.launchIssue",
				"key": "ctrl+alt+shift+t"
			}
		],
		"configuration": {
			"title": "UnioTasks",
			"properties": {
				"uniotasks.repo": {
					"type": "string",
					"default": "",
					"description": "GitHub репозиторий (Owner/Repo). Если пусто — берётся из git remote."
				},
				"uniotasks.label": {
					"type": "string",
					"default": "todo-task",
					"description": "Метка задач, попадающих в панель (пусто = все открытые)."
				},
				"uniotasks.autoRefreshSeconds": {
					"type": "number",
					"default": 30,
					"minimum": 10,
					"description": "Период автообновления списка в секундах (0 = только вручную)."
				}
			}
		}
	},
	"__metadata": {
		"installedTimestamp": 1787790992005,
		"targetPlatform": "undefined",
		"size": 105033
	}
}