endif
else
set oU=oU-1
set dgR=gU[oU]
endif
return dgR
endfunction
function PFw takes integer RFw returns integer
local integer kFw=ygR()
local integer qFw=kFw
local integer wFw=qFw
set nRY[wFw]=B_R()
set rRY[wFw]=0
set tRY[wFw]=0.
set hRY[wFw]=0.
return kFw
endfunction
