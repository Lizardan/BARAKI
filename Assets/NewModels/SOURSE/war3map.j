function R5Z takes string d3Z,real y3Z,real J3Z,boolean S3Z returns framehandle
local framehandle c3Z=Esq(Tu,"",wH,"",0)
local framehandle U3Z=c3Z
local framehandle Y5Z
local framehandle G5Z
call BlzFrameSetSize(U3Z,y3Z,J3Z)
set Y5Z=c3Z
set G5Z=Y5Z
call BlzFrameSetTexture(G5Z,d3Z,0,S3Z)
set LIY=Y5Z
set c3Z=null
set U3Z=null
set Y5Z=null
set G5Z=null
return LIY
endfunction
function t1P takes string L1P,real W1P,real n1P,boolean r1P returns framehandle
return R5Z(L1P,W1P,n1P,r1P)
endfunction
function vow takes string fow,real bow,boolean Qow returns framehandle
return t1P(fow,bow,bow,Qow)
endfunction
function wPk takes string qPk returns framehandle
return vow(qPk,.025,false)
