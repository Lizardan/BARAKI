function DHZ takes integer aHZ returns string
if aHZ==0 then
return "|cffADADADtrace|r"
elseif aHZ==1 then
return "|cff2685DCdebug|r"
elseif aHZ==2 then
return "|cffFFCC00info|r"
elseif aHZ==3 then
return "|cffF47E3Ewarning|r"
else
return "|cffFB2700error|r"
endif
endfunction
function fYZ takes string OYZ returns nothing
local player NYZ=DE
local string aYZ=OYZ
local string DYZ
if AE<=3 then
set DYZ=DHZ(3)+" - "+aYZ
call DisplayTimedTextToPlayer(NYZ,0.,0.,XE,DYZ)
endif
set NYZ=null
endfunction
function wQZ takes integer qQZ returns boolean
return L6[qQZ]==0
endfunction
function ikZ takes integer ekZ returns boolean
local boolean BkZ=wQZ(ekZ)
return BkZ
