function CIP takes nothing returns nothing
local unit uIP=GetKillingUnit()
local integer OIP=GetPlayerTechCount(JOR(uIP),uT,true)
local real NIP
local real aIP
local texttag DIP
local texttag fIP
local real bIP
local real QIP
local texttag vIP
local texttag pIP
local texttag VIP
local texttag mIP
local texttag FIP
local texttag gIP
local texttag oIP
if OIP>0 and HfZ(GetDyingUnit(),UNIT_TYPE_HERO) then
set NIP=wnZ(uIP)
set aIP=wYR(uIP)
call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdl",NIP,aIP))
set DIP=CreateTextTag()
set fIP=DIP
set bIP=NIP
set QIP=aIP
call SetTextTagPos(fIP,bIP,QIP,50.)
set vIP=DIP
call SetTextTagColor(vIP,$ff,0,0,$ff)
set pIP=DIP
call SetTextTagLifespan(pIP,6.)
set VIP=DIP
call SetTextTagFadepoint(VIP,4.)
set mIP=DIP
call SetTextTagVisibility(mIP,true)
set FIP=DIP
call SetTextTagPermanent(FIP,false)
set gIP=DIP
call SetTextTagText(gIP,"Battle Rage",.023)
set oIP=DIP
call SetTextTagVelocity(oIP,0.,.03)
call Qsq(JOR(uIP),OT,OIP,aC,NIP,aIP)
endif
set uIP=null
set DIP=null
set fIP=null
set vIP=null
set pIP=null
set VIP=null
set mIP=null
set FIP=null
set gIP=null
set oIP=null
endfunction
